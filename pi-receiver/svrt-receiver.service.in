[Unit]
Description=H.265 SVRT Raspberry Pi receiver
Wants=network-online.target
After=network-online.target getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=svrt-receiver
Group=svrt-receiver
SupplementaryGroups=video render
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=HOME=/var/lib/svrt-receiver
StateDirectory=svrt-receiver
ExecStartPre=+/bin/sh -c "printf '\\033[2J\\033[H\\033[?25l' > /dev/tty1"
ExecStartPre=+@CMAKE_INSTALL_FULL_LIBEXECDIR@/svrt/force-5ghz.sh
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/svrt-receiver 9944
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
