#!/bin/sh
set -eu

# Keep early VM supervisor failures visible on the serial console. This only
# reports the exit status and shell line, never account or environment data.
vm_console_exit() {
  vm_console_status=$?
  printf 'STEARLIGHT VM CONSOLE EXIT status=%s line=%s\n' \
    "$vm_console_status" "${LINENO:-unknown}" >>/dev/ttyS0 2>/dev/null || true
  exit "$vm_console_status"
}
trap vm_console_exit EXIT
printf '%s\n' 'STEARLIGHT VM CONSOLE START' >>/dev/ttyS0

export XDG_RUNTIME_DIR=/run/user/1000
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=gamescope
# Steam WebHelper initializes X/GTK input-method state before it creates the
# Gamepad UI surface.  The appliance has no login manager to provide a locale;
# use the libc-provided UTF-8 locale so XOpenIM and font setup are deterministic
# on every boot.
export LANG=${LANG:-C.UTF-8}
export LC_ALL=${LC_ALL:-C.UTF-8}
export LC_CTYPE=${LC_CTYPE:-C.UTF-8}
export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-/home/stearlight/.config}
export STEARLIGHT_STEAM_HOME=/home/stearlight
export STEARLIGHT_STEAM_USER=stearlight
if [ -z "${XDG_CACHE_HOME:-}" ]; then
  export XDG_CACHE_HOME="$STEARLIGHT_STEAM_HOME/.cache"
fi
mkdir -p "$XDG_CACHE_HOME/fontconfig"
if [ "$XDG_CACHE_HOME" = "$STEARLIGHT_STEAM_HOME/.cache" ]; then
  chown stearlight:stearlight "$XDG_CACHE_HOME" "$XDG_CACHE_HOME/fontconfig"
fi
export STEARLIGHT_STEAM_BINARY=/usr/bin/steam
export STEARLIGHT_STEAM_LAUNCHER=/usr/local/libexec/stearlight/steam32-launch
export STEARLIGHT_STEAM_PREPARE=/usr/local/libexec/stearlight/steam-firstboot
export STEARLIGHT_STEAMUI_PATCH=/usr/local/libexec/stearlight/patch-steamui-network
# Steam verifies every WebUI chunk before starting; keep the optional network
# workaround off by default so it cannot force an update loop.
export STEARLIGHT_STEAMUI_PATCH_ENABLED=${STEARLIGHT_STEAMUI_PATCH_ENABLED:-0}
export STEARLIGHT_STEAM_RUNTIME_SEED=/usr/lib/steam
export STEARLIGHT_STEAM_RUNTIME_WATCH=/usr/local/libexec/stearlight/steam-runtime-watch
# The x86_64 VM contains Valve's authorized SteamVR runtime.  Start its
# coordinator by default so vrserver/vrdashboard own the dashboard bar and
# laser.
export STEARLIGHT_NATIVE_STEAMVR=${STEARLIGHT_NATIVE_STEAMVR:-1}
export STEARLIGHT_STEAMVR_ROOT=${STEARLIGHT_STEAMVR_ROOT:-/opt/steamvr}
# QEMU has no physical HMD or tracked controllers. Enable the VM-only OpenVR
# provider installed in the image; it supplies a tracking-only HMD plus two
# stable Steam Frame controller poses while Valve's compositor owns the mirror
# window.
export STEARLIGHT_FAKE_TRACKING=${STEARLIGHT_FAKE_TRACKING:-1}
# Keep the synthetic HMD in tracking-only mode so it cannot claim a physical
# display or force DRM direct mode on the QEMU output.
# Advance the Valve Steam Frame first-run surface once in QEMU. This only
# affects the VM's deterministic fake controller.
export STEARLIGHT_FAKE_AUTO_SELECT=${STEARLIGHT_FAKE_AUTO_SELECT:-0}
export STEARLIGHT_FAKE_OPEN_DASHBOARD=${STEARLIGHT_FAKE_OPEN_DASHBOARD:-1}
# Valve's vrcompositor-launcher normally re-enters Steam Runtime. The VM's
# Alpine host has no complete scout runtime for shell utilities, so use Valve's
# documented safety bypass after vm-console has established the SteamVR loader
# environment. This bypass is specific to this minimal VM image.
export VALVE_SKIP_RUNTIME_SAFETY=${VALVE_SKIP_RUNTIME_SAFETY:-1}
# VM boots are intentionally traceable: this overlay is only used by the
# disposable QEMU image and the serial log is the only diagnostic channel.
# Keep this extra output limited to the disposable VM image.
export STEARLIGHT_TRACE_VM_GPU=${STEARLIGHT_TRACE_VM_GPU:-1}
# The patched Steam Runtime selects an ABI-specific Mesa seed for each
# executable it launches.  Enabling this at the runtime boundary prevents the
# The standard multiarch DRI directories are ABI-aware and are populated by
# the VM seed step below.  Keep the private seed opt-in: steam.sh shares one
# environment between its 32-bit bootstrap and 64-bit WebHelper, so exporting
# the i386 seed here would make the latter open an ELF32 swrast module.
export STEARLIGHT_STEAM_USE_SEED_DRI=${STEARLIGHT_STEAM_USE_SEED_DRI:-0}
export STEARLIGHT_STEAM_FORCE_RUN=${STEARLIGHT_STEAM_FORCE_RUN:-0}
# Keep the bootstrap DRI override opt-in. The Steam process tree contains both
# 32-bit and 64-bit GL clients; a global i386 path makes the 64-bit branch load
# an ELF32 swrast module and abort. Mesa's multiarch search path is correct for
# both ABIs in the VM.
export STEARLIGHT_STEAM_BOOTSTRAP_DRI=${STEARLIGHT_STEAM_BOOTSTRAP_DRI:-}
# The stable Steam branch is entered through Valve's steam.sh bootstrap.  It
# performs the normal runtime hand-off and starts the Gamepad UI client after
# verification; the steamrt64 binary is only an explicit diagnostic path for
# non-stable beta branches.
export STEARLIGHT_STEAM_FORCE_DIRECT_CLIENT=${STEARLIGHT_STEAM_FORCE_DIRECT_CLIENT:-0}
# This minimal QEMU guest has no SteamOS portal broker for the private PID
# namespace used by pressure-vessel. That makes the Gamepad UI WebSocket peer
# fail its PID check even though CEF itself is healthy. Keep the VM on the
# host-PID WebHelper entry point by default.
export STEARLIGHT_STEAM_DIRECT_WEBHELPER=${STEARLIGHT_STEAM_DIRECT_WEBHELPER:-1}
# The VM uses Valve's x86 Steam client. The stable SteamOS tree contains the
# Gamepad UI and OOBE assets and avoids routing back to the legacy client.
# Keep the VM on the same stable SteamOS branch baked by
# preextract-steam-client.sh.  Rewriting this to publicbeta on every boot
# forces a full client update before the OOBE can create a surface.
export STEARLIGHT_STEAM_BETA=${STEARLIGHT_STEAM_BETA:-steamdeck_stable}
# The tested VM path is Virtio-GPU/Venus with Valve's native Gamescope session.
# Refuse VGA/X11/SDL fallbacks: they cannot present the authentic SteamVR
# dashboard mirror and laser in the same runtime path.
if command -v modprobe >/dev/null 2>&1; then
  modprobe drm 2>/dev/null || true
  modprobe virtio_pci 2>/dev/null || true
  modprobe virtio_gpu 2>/dev/null || true
fi

# Detect the actual DRM driver, not merely the presence of /dev/dri.
vm_has_virtio_gpu=0
for drm_driver in /sys/class/drm/card*/device/driver; do
  [ -e "$drm_driver" ] || continue
  case "$(readlink "$drm_driver" 2>/dev/null || true)" in
    *virtio*) vm_has_virtio_gpu=1; break ;;
  esac
done
if [ "$vm_has_virtio_gpu" != 1 ] ||
   [ ! -r /usr/share/vulkan/icd.d/virtio_icd.x86_64.json ]; then
  printf '%s\n' 'STEARLIGHT ERROR: QEMU Virtio-GPU/Venus is required; enable virtio-gpu-gl-pci with Venus.' >>/dev/ttyS0
  exit 1
fi
export STEARLIGHT_GAMESCOPE_VK_ICD=/usr/share/vulkan/icd.d/virtio_icd.x86_64.json
if [ "${STEARLIGHT_TRACE_VM_GPU:-0}" != 0 ]; then
  printf 'STEARLIGHT VM GPU DEVICES: ' >>/dev/ttyS0
  ls -1 /dev/dri >>/dev/ttyS0 2>&1 || true
fi
# Do not export a Steam ICD from the session supervisor. Steam starts a mixed
# 32/64-bit process tree (bootstrap, WebHelper and pressure-vessel); a single
# inherited manifest is ABI-specific and makes one side fail with
# VK_ERROR_INCOMPATIBLE_DRIVER. gamescope-session-plus receives the native
# Alpine ICD through STEARLIGHT_GAMESCOPE_VK_ICD, while steam32-launch selects an
# ABI-matched ICD only at an explicit direct-runtime boundary.
unset VK_ICD_FILENAMES VK_DRIVER_FILES
export STEAM_BOOTSTRAP_CONFIG=/home/stearlight/.config/gamescope/bootstrap.cfg
export STEAMOS_STEAM_REBOOT_SENTINEL=/tmp/steamos-reboot-sentinel
export REBOOT_SENTINEL=$STEAMOS_STEAM_REBOOT_SENTINEL
export STEAMOS_STEAM_SHUTDOWN_SENTINEL=/tmp/steamos-shutdown-sentinel
export SHUTDOWN_SENTINEL=$STEAMOS_STEAM_SHUTDOWN_SENTINEL
export STEAM_GAMESCOPE=1
export STEAM_GAMESCOPE_WAYLAND=1
export STEAM_GAMEPADUI=1
export STEAMOS_OOBE=1
export STEAMOS_OOBE_IMAGE=1
export STEAM_GAMESCOPE_VRR_SUPPORTED=1
export STEAM_GAMESCOPE_HAS_TEARING_SUPPORT=1
export STEAM_GAMESCOPE_TEARING_SUPPORTED=1
export STEAM_GAMESCOPE_HDR_SUPPORTED=1
export STEAM_GAMESCOPE_DYNAMIC_FPSLIMITER=1
export STEAM_GAMESCOPE_NIS_SUPPORTED=1
export STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT=1
export STEAM_GAMESCOPE_COLOR_MANAGED=1
export STEAM_GAMESCOPE_VIRTUAL_WHITE=1
export STEAM_MANGOAPP_PRESETS_SUPPORTED=1
export STEAM_MANGOAPP_HORIZONTAL_SUPPORTED=1
export STEAM_USE_MANGOAPP=1
export STEAM_DISABLE_MANGOAPP_ATOM_WORKAROUND=1
export STEAM_USE_DYNAMIC_VRS=1
export STEAM_MULTIPLE_XWAYLANDS=1
export STEAM_ENABLE_VOLUME_HANDLER=1
export STEAM_ALLOW_DRIVE_UNMOUNT=1
export STEAM_ALLOW_DRIVE_ADOPT=1
export SRT_URLOPEN_PREFER_STEAM=1
export STEAM_DISABLE_AUDIO_DEVICE_SWITCHING=1
export QT_IM_MODULE=steam
export GTK_IM_MODULE=Steam
export XCURSOR_THEME=steam
export XCURSOR_SCALE=256
export GAMESCOPE_FALLBACK_APPID=0x41524d41
# Keep the VM's Steam client update path enabled.  The previous diagnostic
# defaults disabled bootstrap updates, so Steam downloaded the WebUI package
# but never applied it; after the next boot it was still running the old
# client and WebHelper could not complete the Gamepad UI handshake.  The
# network bridge patch is applied before launch and is deliberately kept
# outside Valve's replaceable tree, so normal Steam verification/update logic
# can run here.
export STEARLIGHT_VM_STEAM_UPDATE_ARGS="${STEARLIGHT_VM_STEAM_UPDATE_ARGS:-}"
# Match the SteamOS/Armada session contract exactly.  The old VM-only
# -720p/-fasthtml/VR switches were useful while debugging the updater, but
# they select a different WebUI bootstrap path and are not part of a normal
# Steam Deck welcome session.
# Match Armada's native SteamOS launch contract. The VM can exercise the
# client UI, but it cannot emulate the headset's tracking hardware; Steam's
# own Steam Link/VRLink handler remains the only streaming entry point.
export STEARLIGHT_STEAM_FRAME=${STEARLIGHT_STEAM_FRAME:-1}
steam_frame_arg=
if [ "$STEARLIGHT_STEAM_FRAME" != 0 ]; then
  steam_frame_arg=' -steamframe'
fi
export CLIENTCMD="/usr/local/libexec/stearlight/steam32-launch -gamepadui -steamos3 -steampal -steamdeck${steam_frame_arg} ${STEARLIGHT_VM_STEAM_UPDATE_ARGS}"
export CURSOR_FILE="$STEARLIGHT_STEAM_HOME/.local/share/Steam/tenfoot/resource/images/cursors/arrow.png"
# Keep the small set of WebHelper logs visible on the VM serial console. This
# is VM-only diagnostics and is useful because the guest has no SSH session.
export STEARLIGHT_TRACE_STEAM_LOGS=${STEARLIGHT_TRACE_STEAM_LOGS:-1}
export STEARLIGHT_TRACE_STEAM_RUNTIME=${STEARLIGHT_TRACE_STEAM_RUNTIME:-1}
if [ "${STEARLIGHT_TRACE_STEAM_RUNTIME}" != 0 ]; then
  # Keep the pressure-vessel decision visible in the serial log while the VM
  # path is being brought up. These are no-op diagnostics when the runtime is
  # already healthy and are disabled by production callers.
  export PRESSURE_VESSEL_VERBOSE=1
  export STEAM_LINUX_RUNTIME_VERBOSE=1
fi

# Keep the optional SteamRT marker available for beta diagnostics.  The normal
# stable launch below intentionally goes through steam.sh, which chooses the
# correct client branch from package/beta and only then starts WebHelper.
steam_data="$STEARLIGHT_STEAM_HOME/.local/share/Steam"
if [ -x "$steam_data/steamrt64/steam" ]; then
  # The marker is persistent Steam state.  Create it only when an image was
  # built without one; never overwrite Valve's branch choice on later boots.
  [ -e "$steam_data/.steam-enable-steamrt64-client" ] ||
    : > "$steam_data/.steam-enable-steamrt64-client"
  mkdir -p "$steam_data/package"
  [ -s "$steam_data/package/beta" ] ||
    printf '%s\n' "$STEARLIGHT_STEAM_BETA" > "$steam_data/package/beta"
fi

# Steam's pressure-vessel/bwrap runtime requires unprivileged user
# namespaces.  Alpine's minimal VM kernel leaves the limits conservative (and
# some builds default the Debian compatibility knob to 0), which makes Steam
# stop at its own "user namespaces are required" prompt before WebUI starts.
# Apply the settings before dropping to the stearlight user.  Unknown knobs are
# harmless on kernels that do not expose them; the user.max_user_namespaces
# limit is the upstream control used by Alpine's linux-virt kernel.
if command -v sysctl >/dev/null 2>&1; then
  sysctl -w user.max_user_namespaces=1048576 2>/dev/null || true
  sysctl -w kernel.unprivileged_userns_clone=1 2>/dev/null || true
  sysctl -w kernel.apparmor_restrict_unprivileged_userns=0 2>/dev/null || true
  # CEF/WebHelper reserves a large virtual address space.  These are safe
  # defaults for the sealed VM and avoid mmap(ENOMEM) when pressure-vessel
  # starts the 64-bit helper; kernels without a knob simply ignore it.
  sysctl -w vm.max_map_count=2147483642 2>/dev/null || true
  sysctl -w vm.overcommit_memory=1 2>/dev/null || true
  sysctl -w vm.overcommit_ratio=100 2>/dev/null || true
fi

# OpenRC/supervise-daemon may inherit a conservative address-space limit from
# the initramfs.  Chromium/CEF needs a large sparse virtual address range,
# even though it commits little physical memory.  Lift only the limits for
# this VM session; the production service remains governed by its unit limits.
ulimit -v unlimited 2>/dev/null || true
ulimit -m unlimited 2>/dev/null || true
ulimit -d unlimited 2>/dev/null || true
ulimit -l unlimited 2>/dev/null || true
ulimit -n 1048576 2>/dev/null || true

if [ "${STEARLIGHT_TRACE_VM_GPU:-0}" != 0 ]; then
  {
    printf '%s\n' 'STEARLIGHT VM MEMORY LIMITS BEGIN'
    ulimit -a
    printf '%s\n' '--- /proc/meminfo ---'
    sed -n '1,12p' /proc/meminfo
    printf '%s\n' '--- vm knobs ---'
    for knob in max_map_count overcommit_memory overcommit_ratio; do
      printf '%s=' "$knob"
      cat "/proc/sys/vm/$knob" 2>/dev/null || true
    done
    printf '%s\n' '--- shared memory ---'
    df -h /dev/shm 2>/dev/null || true
    printf '%s\n' 'STEARLIGHT VM MEMORY LIMITS END'
  } >>/dev/ttyS0 2>&1 || true
fi

# Chromium/CEF uses shared-memory mappings for compositor surfaces and its
# offscreen JS context.  The minimal VM kernel otherwise mounts /dev/shm with
# a tiny default, which presents as repeated mmap(ENOMEM) and a blank Steam
# WebHelper even when the guest has free RAM.  Give the test session a bounded
# tmpfs large enough for those surfaces without reserving physical memory.
if command -v mount >/dev/null 2>&1; then
  if mountpoint -q /dev/shm 2>/dev/null; then
    mount -o remount,size=${STEARLIGHT_VM_SHM_SIZE:-2G} /dev/shm 2>/dev/null || true
  else
    mount -t tmpfs -o mode=1777,size=${STEARLIGHT_VM_SHM_SIZE:-2G} tmpfs /dev/shm 2>/dev/null || true
  fi
fi

# pressure-vessel's capsule loader requires a host ldconfig cache. Keep this
# repair in the privileged VM session as well as the image build: it makes an
# older VM overlay recover without another multi-stage build.
if [ ! -s /var/cache/ldconfig/ld.so.cache ]; then
  steam_cache=$(find "$STEARLIGHT_STEAM_HOME/.local/share/Steam" -type f \
    -path '*/files/etc/ld.so.cache' -print -quit 2>/dev/null || true)
  if [ -n "$steam_cache" ]; then
    mkdir -p /var/cache/ldconfig 2>/dev/null || true
    cp -L "$steam_cache" /var/cache/ldconfig/ld.so.cache 2>/dev/null || true
  fi
fi

# The Alpine compatibility layer may ship empty placeholder DRI directories.
# Pressure-vessel discovers host GL drivers before it starts WebHelper; if the
# x86_64 directory is empty it falls through to the valid i386 swrast module
# and the CEF process aborts with ELFCLASS32. Populate only an absent/empty
# swrast entry from the ABI-matched Steam Runtime seed.
seed_host_dri() {
  abi=$1
  target=$2
  source="$STEARLIGHT_STEAM_RUNTIME_SEED/stearlight_libs_${abi}/dri"
  if [ ! -d "$source" ]; then
    source=$(find "$STEARLIGHT_STEAM_HOME/.local/share/Steam/ubuntu12_32/steam-runtime" \
      -path "*/stearlight_libs_${abi}/dri" -type d -print -quit 2>/dev/null || true)
  fi
  [ -d "$source" ] || return 0
  magic=
  if [ -r "$target/swrast_dri.so" ]; then
    magic=$(dd if="$target/swrast_dri.so" bs=1 count=4 2>/dev/null |
      od -An -tx1 | tr -d '[:space:]')
  fi
  case "$magic" in
    7f454c46*) return 0 ;;
  esac
  mkdir -p "$target" 2>/dev/null || return 0
  cp -a "$source"/. "$target"/ 2>/dev/null || true
}

# Steam may replace ubuntu12_32/steam-runtime while applying its first client
# update.  Keep an ABI-matched copy outside that replaceable tree so the
# watcher can restore Mesa modules (and their matching glibc dependencies)
# after the update completes.  Extract only the small stearlight seed from
# Valve's bootstrap archive; do not unpack a second full Steam runtime.
ensure_steam_runtime_seed() {
  abi=$1
  target="$STEARLIGHT_STEAM_RUNTIME_SEED/stearlight_libs_${abi}"
  archive=/usr/lib/steam/bootstraplinux_ubuntu12_32.tar.xz
  [ -r "$target/dri/swrast_dri.so" ] && return 0
  [ -r "$archive" ] || return 0
  tmp="/var/lib/stearlight/.steam-seed.$$"
  rm -rf "$tmp"
  mkdir -p "$tmp"
  path="./ubuntu12_32/steam-runtime/stearlight_libs_${abi}"
  if tar -xJf "$archive" -C "$tmp" "$path" 2>/dev/null; then
    extracted="$tmp/ubuntu12_32/steam-runtime/stearlight_libs_${abi}"
    if [ -d "$extracted" ]; then
      mkdir -p "$target"
      cp -a "$extracted"/. "$target"/ 2>/dev/null || true
    fi
  fi
  rm -rf "$tmp"
}
ensure_steam_runtime_seed 32
ensure_steam_runtime_seed 64
seed_host_dri 32 /usr/lib/i386-linux-gnu/dri
seed_host_dri 64 /usr/lib/x86_64-linux-gnu/dri

# The VM enters the gamescope session directly, so there is no C-bridge
# callback to run the common first-boot preparation hook.  Run it explicitly
# as root before dropping to the Steam user: the extracted Steam Runtime in a
# sealed image is root-owned, and the ABI repair must finish before Steam
# starts.  Hand ownership back afterward so Valve can update the per-user
# tree normally.
if [ -x "$STEARLIGHT_STEAM_PREPARE" ]; then
  "$STEARLIGHT_STEAM_PREPARE" >>/dev/ttyS0 2>&1 || true
  if [ "${STEARLIGHT_STEAMUI_PATCH_ENABLED:-0}" = 1 ] &&
     [ -x "$STEARLIGHT_STEAMUI_PATCH" ]; then
    "$STEARLIGHT_STEAMUI_PATCH" >>/dev/ttyS0 2>&1 || true
  fi
  chown -R stearlight:stearlight "$STEARLIGHT_STEAM_HOME/.local/share/Steam" \
    "$STEARLIGHT_STEAM_HOME/.steam" "$STEARLIGHT_STEAM_HOME/.config" \
    "$STEARLIGHT_STEAM_HOME/.cache" 2>/dev/null || true
 fi
printf '%s\n' 'STEARLIGHT VM CONSOLE AFTER PREPARE' >>/dev/ttyS0

# Steam's IPC and WebUI bind loopback sockets (including the local remote
# debugger). Minimal Alpine boots can leave `lo` down until a desktop network
# manager starts, so initialize it before launching the client.
if command -v ip >/dev/null 2>&1; then
  ip link set lo up 2>/dev/null || true
  ip addr add 127.0.0.1/8 dev lo 2>/dev/null || true
  ip -6 addr add ::1/128 dev lo 2>/dev/null || true
fi
# Valve's WebUI transport uses this hostname for the local-only websocket.
# Public DNS normally maps it to loopback, but a minimal/offline Alpine boot
# must not depend on DNS being ready before Steam starts.
if [ -w /etc/hosts ] && ! grep -Eq '^[[:space:]]*127\.0\.0\.1[[:space:]].*([[:space:]]|^)steamloopback\.host([[:space:]]|$)' /etc/hosts; then
  printf '%s\n' '127.0.0.1 steamloopback.host' >>/etc/hosts
fi

mkdir -p /home/stearlight/.steam /home/stearlight/.local/share
# SteamVR's vrstartup/vrpathreg pair runs before the client has a chance to
# create desktop-session state. Provision the user paths it requires up front
# so its registry, logs, D-Bus cookie, and runtime socket are writable when the
# Valve binaries are launched as stearlight.
mkdir -p /home/stearlight/.config/openvr /home/stearlight/.dbus \
  /home/stearlight/.steam/steam/config /home/stearlight/.steam/steam/logs \
  /run/user/1000
chmod 0700 /home/stearlight/.dbus /run/user/1000
printf '%s\n' 'STEARLIGHT VM CONSOLE AFTER CHMOD' >>/dev/ttyS0
chown -R stearlight:stearlight /home/stearlight/.config \
  /home/stearlight/.dbus /home/stearlight/.steam /run/user/1000
printf '%s\n' 'STEARLIGHT VM CONSOLE AFTER USER PATH CHOWN' >>/dev/ttyS0
export VR_PATHREG_OVERRIDE=/home/stearlight/.config/openvr/openvrpaths.vrpath
# Steam's client and pressure-vessel logger expect this directory to exist
# before the first WebHelper/update process starts.  A sealed image otherwise
# reaches Steam's updater and then aborts in CFrameFunctionMgr while trying to
# initialize its assertion dump path.
mkdir -p "$steam_data/logs"
printf '%s\n' 'STEARLIGHT VM CONSOLE AFTER STEAM LOG DIR' >>/dev/ttyS0
ln -sfn /home/stearlight/.local/share/Steam /home/stearlight/.steam/root
printf '%s\n' 'STEARLIGHT VM CONSOLE AFTER ROOT LINK' >>/dev/ttyS0
ln -sfn /home/stearlight/.local/share/Steam /home/stearlight/.steam/steam
printf '%s\n' 'STEARLIGHT VM CONSOLE AFTER STEAM LINK' >>/dev/ttyS0
chown -R stearlight:stearlight /home/stearlight/.steam /home/stearlight/.local
printf '%s\n' 'STEARLIGHT VM DISPLAY READY 2880x1600 @ 60Hz' >>/dev/ttyS0

# Let dhcpcd obtain the user-mode NAT lease before Steam performs its first
# manifest request in the native Gamescope session.
attempt=0
while [ "$attempt" -lt 15 ]; do
  if ip route show default 2>/dev/null | grep -q default; then
    break
  fi
  attempt=$((attempt + 1))
  sleep 1
done

# Keep this supervisor alive for the lifetime of Valve's Gamescope session.
shell_pid=
watcher_pid=
steam_log_tail_pid=
steam_process_trace_pid=
native_ready_pid=
cleanup_session() {
  if [ -n "${shell_pid:-}" ]; then
    kill "$shell_pid" 2>/dev/null || true
    wait "$shell_pid" 2>/dev/null || true
  fi
  if [ -n "${watcher_pid:-}" ]; then
    kill "$watcher_pid" 2>/dev/null || true
    wait "$watcher_pid" 2>/dev/null || true
  fi
  if [ -n "${steam_log_tail_pid:-}" ]; then
    kill "$steam_log_tail_pid" 2>/dev/null || true
    wait "$steam_log_tail_pid" 2>/dev/null || true
  fi
  if [ -n "${steam_process_trace_pid:-}" ]; then
    kill "$steam_process_trace_pid" 2>/dev/null || true
    wait "$steam_process_trace_pid" 2>/dev/null || true
  fi
  if [ -n "${native_ready_pid:-}" ]; then
    kill "$native_ready_pid" 2>/dev/null || true
    wait "$native_ready_pid" 2>/dev/null || true
  fi
}
trap cleanup_session EXIT INT TERM

# Steam replaces parts of ubuntu12_32/steam-runtime during its first client
# update. It can briefly leave zero-byte compatibility libraries behind while
# the 32-bit bootstrap is already creating its GLX window. Keep the small
# ABI-repair loop alive before Steam starts, so that replacement is repaired
# during that window instead of after the client has crashed.
if [ -x "$STEARLIGHT_STEAM_RUNTIME_WATCH" ]; then
  su-exec stearlight env \
    HOME="$STEARLIGHT_STEAM_HOME" \
    STEARLIGHT_STEAM_RUNTIME_SEED="$STEARLIGHT_STEAM_RUNTIME_SEED" \
    "$STEARLIGHT_STEAM_RUNTIME_WATCH" >>/dev/ttyS0 2>&1 &
  watcher_pid=$!
fi

set +e
export BACKEND=drm
export SCREEN_WIDTH=2880
export SCREEN_HEIGHT=1600
export STEARLIGHT_GAMESCOPE_OUTPUT_WIDTH=${STEARLIGHT_VM_OUTPUT_WIDTH:-2880}
export STEARLIGHT_GAMESCOPE_OUTPUT_HEIGHT=${STEARLIGHT_VM_OUTPUT_HEIGHT:-1600}
export INTERNAL_WIDTH=${STEARLIGHT_VM_INTERNAL_WIDTH:-$STEARLIGHT_GAMESCOPE_OUTPUT_WIDTH}
export INTERNAL_HEIGHT=${STEARLIGHT_VM_INTERNAL_HEIGHT:-$STEARLIGHT_GAMESCOPE_OUTPUT_HEIGHT}
export NESTED_REFRESH=60
su-exec stearlight env USER=stearlight LOGNAME=stearlight HOME="$STEARLIGHT_STEAM_HOME" \
  dbus-launch --exit-with-session \
  /usr/bin/gamescope-session-plus steam \
  2>>/dev/ttyS0 &
shell_pid=$!
if [ "${STEARLIGHT_NATIVE_STEAMVR:-1}" != 0 ]; then
  # Coordinator startup alone is not proof that Valve's dock can render.
  # The compositor must finish GPU setup and the dashboard must remain live.
  (
    compositor_log="$STEARLIGHT_STEAM_HOME/.local/share/Steam/logs/vrcompositor.txt"
    dashboard_log="$STEARLIGHT_STEAM_HOME/.local/share/Steam/logs/vrdashboard.txt"
    attempts=0
    while [ "$attempts" -lt 300 ] && kill -0 "$shell_pid" 2>/dev/null; do
      if busybox pidof vrcompositor >/dev/null 2>&1 &&
         busybox pidof vrdashboard >/dev/null 2>&1 &&
         [ -r "$compositor_log" ] && [ -r "$dashboard_log" ] &&
         awk '/vrcompositor .* startup with PID=/{start=NR}
              /End GPU speed/{done=NR}
              END{exit !(start>0 && done>start)}' "$compositor_log" &&
         awk '/vrdashboard .* startup with PID=/{start=NR}
              /VR_Init failed/{failed=NR}
              END{exit !(start>0 && failed<start)}' "$dashboard_log"; then
        printf '%s\n' 'STEARLIGHT NATIVE COMPONENTS READY' >>/dev/ttyS0
        attempts=0
        while [ "$attempts" -lt 120 ] && kill -0 "$shell_pid" 2>/dev/null; do
          if grep -Fq 'pulsing dashboard system button' \
              "$steam_data/logs/vrserver.txt" 2>/dev/null; then
            printf '%s\n' 'STEARLIGHT DASHBOARD INPUT READY' >>/dev/ttyS0
            exit 0
          fi
          attempts=$((attempts + 1))
          sleep 1
        done
        printf '%s\n' 'STEARLIGHT DASHBOARD INPUT NOT READY' >>/dev/ttyS0
        exit 0
      fi
      attempts=$((attempts + 1))
      sleep 1
    done
    printf '%s\n' 'STEARLIGHT NATIVE COMPONENTS NOT READY' >>/dev/ttyS0
  ) &
  native_ready_pid=$!
fi
if [ "${STEARLIGHT_TRACE_STEAM_PROCESSES:-0}" != 0 ]; then
  # The WebUI transport log reports the PID that owns the connecting socket.
  # Keep a short process/namespace sample in the serial log so a VM-only
  # transport failure can be diagnosed without attaching a debugger.  Do not
  # dump the full environment: Steam tokens and account data may be present.
  (
    trace_remaining=${STEARLIGHT_TRACE_STEAM_PROCESS_SECONDS:-20}
    while [ "$trace_remaining" -gt 0 ] && kill -0 "$shell_pid" 2>/dev/null; do
      printf '%s\n' 'STEARLIGHT STEAM PROCESS TRACE BEGIN' >>/dev/ttyS0
      for process_dir in /proc/[0-9]*; do
        [ -r "$process_dir/cmdline" ] || continue
        process_pid=${process_dir##*/}
        process_cmd=$(tr '\000' ' ' <"$process_dir/cmdline" 2>/dev/null || true)
        case "$process_cmd" in
          *steamwebhelper*|*steamrt64/steam*|*steam.sh*)
            process_ppid=$(awk '/^PPid:/ {print $2; exit}' \
              "$process_dir/status" 2>/dev/null || true)
            process_nspid=$(awk '/^NSpid:/ {$1=""; sub(/^[[:space:]]+/, ""); print; exit}' \
              "$process_dir/status" 2>/dev/null || true)
            process_uid=$(awk '/^Uid:/ {print $2; exit}' \
              "$process_dir/status" 2>/dev/null || true)
            process_pid_ns=$(readlink "$process_dir/ns/pid" 2>/dev/null || true)
            process_net_ns=$(readlink "$process_dir/ns/net" 2>/dev/null || true)
            process_sockets=$(find "$process_dir/fd" -maxdepth 1 -type l \
              -exec readlink {} \; 2>/dev/null |
              grep -o 'socket:\[[0-9]*\]' | tr '\n' ',' || true)
            printf 'STEARLIGHT PROCESS pid=%s ppid=%s nspid=%s uid=%s pidns=%s netns=%s sockets=%s cmd=%s\n' \
              "$process_pid" "$process_ppid" "$process_nspid" "$process_uid" \
              "$process_pid_ns" "$process_net_ns" "$process_sockets" "$process_cmd" >>/dev/ttyS0
            ;;
        esac
      done
      printf '%s\n' 'STEARLIGHT STEAM PROCESS TRACE END' >>/dev/ttyS0
      trace_remaining=$((trace_remaining - 1))
      sleep 1
    done
  ) &
  steam_process_trace_pid=$!
fi
if [ "${STEARLIGHT_TRACE_STEAM_LOGS:-0}" != 0 ]; then
  # Steam creates these files only after the updater hands off to WebHelper.
  # Report appended log data without making logging part of the launch path.
  (
    trace_state=/tmp/stearlight-steam-log-tail
    mkdir -p "$trace_state"
    while kill -0 "$shell_pid" 2>/dev/null; do
      for steam_log in \
        "$steam_data/logs/steamwebhelper.log" \
        "$steam_data/logs/webhelper-linux.txt" \
        "$steam_data/logs/webhelper.txt" \
        "$steam_data/logs/transport_steamui.txt" \
        "$steam_data/logs/steamui.txt" \
        "$steam_data/logs/steamui_login.txt" \
        "$steam_data/logs/connection_log.txt" \
        "$steam_data/logs/cef_log.txt" \
        "$steam_data/logs/bootstrap_log.txt" \
        "$steam_data/logs/transport_client.txt" \
        "$steam_data/logs/webhelper_js.txt"; do
        [ -f "$steam_log" ] || continue
        steam_log_name=${steam_log##*/}
        steam_log_size=$(wc -c <"$steam_log" 2>/dev/null | tr -d '[:space:]')
        steam_log_state="$trace_state/$steam_log_name.size"
        previous_size=$(cat "$steam_log_state" 2>/dev/null || true)
        if [ "$steam_log_size" != "$previous_size" ]; then
          printf 'STEARLIGHT STEAM LOG %s BEGIN\n' "$steam_log_name" >>/dev/ttyS0
          tail -n 100 "$steam_log" >>/dev/ttyS0 2>&1 || true
          printf 'STEARLIGHT STEAM LOG %s END\n' "$steam_log_name" >>/dev/ttyS0
          printf '%s\n' "$steam_log_size" >"$steam_log_state"
        fi
      done
      sleep 5
    done
  ) &
  steam_log_tail_pid=$!
fi
wait "$shell_pid"
shell_status=$?
set -e
shell_pid=
if [ -e /tmp/steamos-suspend-sentinel ]; then
  rm -f /tmp/steamos-suspend-sentinel
  if [ -w /sys/power/state ]; then
    printf '%s\n' mem >/sys/power/state || true
  fi
elif [ -e "${REBOOT_SENTINEL:-/tmp/steamos-reboot-sentinel}" ]; then
  rm -f "${REBOOT_SENTINEL:-/tmp/steamos-reboot-sentinel}"
  reboot || true
elif [ -e "${SHUTDOWN_SENTINEL:-/tmp/steamos-shutdown-sentinel}" ]; then
  rm -f "${SHUTDOWN_SENTINEL:-/tmp/steamos-shutdown-sentinel}"
  poweroff || true
fi
exit "$shell_status"
