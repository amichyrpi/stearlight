+
+   /* PutImage is immediate, so it generates no Present completion event.
+    * A request after the upload provides an X-server completion boundary.
+    * The queue worker has already waited for the real GPU copy fence. */
+   if (result == VK_SUCCESS) {
+      xcb_generic_error_t *upload_error = NULL;
+      xcb_get_input_focus_reply_t *uploaded = xcb_get_input_focus_reply(
