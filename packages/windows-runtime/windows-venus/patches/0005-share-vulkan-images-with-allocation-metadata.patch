diff --git a/src/mesa/util/os_file.c b/src/mesa/util/os_file.c
--- a/src/mesa/util/os_file.c
+++ b/src/mesa/util/os_file.c
@@ -30,6 +30,8 @@
 struct os_win32_handle_entry {
    int token;
    HANDLE handle;
+   bool has_memory_info;
+   struct os_win32_memory_info memory_info;
 };
 
 static CRITICAL_SECTION os_win32_handle_mutex;
@@ -135,6 +137,32 @@
    return os_win32_handle_insert(handle);
 }
 
+bool
+os_get_win32_memory_info(int fd, struct os_win32_memory_info *info)
+{
+   os_win32_handle_ensure_init();
+   EnterCriticalSection(&os_win32_handle_mutex);
+   const ptrdiff_t idx = os_win32_handle_find_index_locked(fd);
+   const bool found = idx >= 0 && os_win32_handles[idx].has_memory_info;
+   if (found) *info = os_win32_handles[idx].memory_info;
+   LeaveCriticalSection(&os_win32_handle_mutex);
+   return found;
+}
+
+bool
+os_set_win32_memory_info(int fd, const struct os_win32_memory_info *info)
+{
+   os_win32_handle_ensure_init();
+   EnterCriticalSection(&os_win32_handle_mutex);
+   const ptrdiff_t idx = os_win32_handle_find_index_locked(fd);
+   if (idx >= 0) {
+      os_win32_handles[idx].memory_info = *info;
+      os_win32_handles[idx].has_memory_info = true;
+   }
+   LeaveCriticalSection(&os_win32_handle_mutex);
+   return idx >= 0;
+}
+
 int
 os_close_fd(int fd)
 {
@@ -189,8 +217,13 @@
       }
 
       const int token = os_wrap_win32_handle(dup_handle);
-      if (token < 0)
+      if (token < 0) {
          CloseHandle(dup_handle);
+      } else {
+         struct os_win32_memory_info info;
+         if (os_get_win32_memory_info(fd, &info))
+            os_set_win32_memory_info(token, &info);
+      }
       return token;
    }
 
