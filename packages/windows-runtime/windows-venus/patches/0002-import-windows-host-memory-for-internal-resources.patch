+static VkResult
+vkr_host_memory_create(struct vkr_device *dev, VkMemoryAllocateInfo *info,
+                        struct vkr_host_memory **out_host,
+                        VkImportMemoryHostPointerInfoEXT *import)
+{
+   const uint64_t alignment = MAX2(dev->physical_device->min_host_pointer_alignment,
+                                   (uint64_t)getpagesize());
+   if (!alignment || info->allocationSize > SIZE_MAX - (alignment - 1))
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   const uint64_t size = (info->allocationSize + alignment - 1) / alignment * alignment;
+   if (!size || !dev->GetMemoryHostPointerPropertiesEXT)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   struct vkr_host_memory *host = calloc(1, sizeof(*host));
+   if (!host)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   host->fd = -1;
+   HANDLE section = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE,
+                                       (DWORD)(size >> 32), (DWORD)size, NULL);
+   if (!section) {
+      free(host);
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+   host->mapping = MapViewOfFile(section, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, size);
+   if (!host->mapping || (uintptr_t)host->mapping % alignment) {
+      CloseHandle(section);
+      vkr_host_memory_destroy(host);
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+   host->fd = os_wrap_win32_handle(section);
+   if (host->fd < 0) {
+      CloseHandle(section);
+      vkr_host_memory_destroy(host);
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+
+   VkMemoryHostPointerPropertiesEXT props = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT,
+   };
+   VkResult ret = dev->GetMemoryHostPointerPropertiesEXT(dev->base.handle.device,
+      VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT, host->mapping, &props);
+   if (ret != VK_SUCCESS || !(props.memoryTypeBits & (1u << info->memoryTypeIndex))) {
+      vkr_host_memory_destroy(host);
+      return ret != VK_SUCCESS ? ret : VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   }
+   *import = (VkImportMemoryHostPointerInfoEXT){
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT,
+      .pNext = info->pNext,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+      .pHostPointer = host->mapping,
+   };
+   info->allocationSize = size;
+   info->pNext = import;
+   *out_host = host;
+   return VK_SUCCESS;
+}
