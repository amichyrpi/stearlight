+void
+vkr_device_memory_release_host_backings(struct vkr_device *dev)
+{
+   while (dev->host_memories) {
+      struct vkr_host_memory *host = dev->host_memories;
+      dev->host_memories = host->next;
+      vkr_host_memory_destroy(host);
+   }
+}
