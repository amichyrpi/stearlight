+#ifdef _WIN32
+static bool
+vkr_physical_device_host_memory_types(struct vkr_physical_device *physical_dev,
+                                      uint32_t *out_types)
+{
+   struct vn_physical_device_proc_table *vk = &physical_dev->proc_table;
+   VkPhysicalDevice physical = physical_dev->base.handle.physical_device;
+   uint32_t count = 0;
+   vk->GetPhysicalDeviceQueueFamilyProperties(physical, &count, NULL);
+   VkQueueFamilyProperties *families = calloc(count, sizeof(*families));
+   if (!count || !families)
+      return false;
+   vk->GetPhysicalDeviceQueueFamilyProperties(physical, &count, families);
+   uint32_t family = 0;
+   while (family < count && !families[family].queueCount)
+      family++;
+   free(families);
+   if (family == count)
+      return false;
+   const float priority = 1.0f;
+   const VkDeviceQueueCreateInfo queue = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = family, .queueCount = 1, .pQueuePriorities = &priority,
+   };
+   const char *extension = "VK_EXT_external_memory_host";
+   const VkDeviceCreateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .queueCreateInfoCount = 1, .pQueueCreateInfos = &queue,
+      .enabledExtensionCount = 1, .ppEnabledExtensionNames = &extension,
+   };
+   VkDevice device = VK_NULL_HANDLE;
+   if (vk->CreateDevice(physical, &info, NULL, &device) != VK_SUCCESS)
+      return false;
+   PFN_vkGetMemoryHostPointerPropertiesEXT get_pointer =
+      (PFN_vkGetMemoryHostPointerPropertiesEXT)
+         vk->GetDeviceProcAddr(device, "vkGetMemoryHostPointerPropertiesEXT");
+   PFN_vkDestroyDevice destroy =
+      (PFN_vkDestroyDevice)vk->GetDeviceProcAddr(device, "vkDestroyDevice");
+   SYSTEM_INFO system;
+   GetSystemInfo(&system);
+   HANDLE section = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE,
+                                       0, system.dwAllocationGranularity, NULL);
+   void *pointer = section ? MapViewOfFile(section, FILE_MAP_READ | FILE_MAP_WRITE,
+                                           0, 0, system.dwAllocationGranularity) : NULL;
+   VkMemoryHostPointerPropertiesEXT props = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT,
+   };
+   VkResult result = pointer && get_pointer
+      ? get_pointer(device, VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+                     pointer, &props)
+      : VK_ERROR_OUT_OF_HOST_MEMORY;
+   if (pointer)
+      UnmapViewOfFile(pointer);
+   if (section)
+      CloseHandle(section);
+   destroy(device, NULL);
+   *out_types = props.memoryTypeBits;
+   return result == VK_SUCCESS && props.memoryTypeBits;
+}
+#endif
 static void
 vkr_physical_device_init_memory_properties(struct vkr_physical_device *physical_dev)
 {
@@ -273,6 +333,23 @@ vkr_physical_device_init_memory_properties(struct vkr_physical_device *physical_
       if (!host.minImportedHostPointerAlignment ||
           system_info.dwAllocationGranularity % host.minImportedHostPointerAlignment)
          physical_dev->host_external_memory_host = false;
+      if (physical_dev->host_external_memory_host) {
+         uint32_t types = 0;
+         if (!vkr_physical_device_host_memory_types(physical_dev, &types)) {
+            physical_dev->host_external_memory_host = false;
+         } else {
+            /* GPU BAR memory is not necessarily importable as a mapped
+             * Windows section. Retain its index for GPU-only allocations. */
+            for (uint32_t i = 0; i < physical_dev->memory_properties.memoryTypeCount; i++) {
+               if (!(types & (1u << i)))
+                  physical_dev->memory_properties.memoryTypes[i].propertyFlags &=
+                     ~(VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                       VK_MEMORY_PROPERTY_HOST_COHERENT_BIT |
+                       VK_MEMORY_PROPERTY_HOST_CACHED_BIT);
+            }
+            vkr_log("Windows section import memory types: 0x%x", types);
+         }
+      }
    }
 #endif
    physical_dev->udmabuf_dev_fd = -1;
