#!/bin/sh
set -eu

binary=${STEARLIGHT_STEAM_ROOT:-/opt/steam}/steamrtarm64/chromehtml.so
# ARM TCG and the Quest Linux runtime can take longer than 500 ms to create
# the helper's two 25 MiB connection buffers. Retrying leaks another pair.
# Extend only the master response stream's wait; keep the IPC protocol intact.
current=$(sha256sum "$binary" | cut -d ' ' -f 1)
case "$current" in
    4ea4e9aa5146e2f4b7c003abd83fb8a4cf6edf2118e8a50c5a7f10ddf14013b0|dd22bb0da0e636a52135aa7b4514abac0fa57799813ee301881559f2195f0171|cf90f845837c6edaddf8fb27dd136ffc6a4187ec8476b01ae1a0059e744b07ce|1f853fe9a31e09cb620a71c99bb2c773f32ea87d28fe26dc9e8621b900c2503e) exit 0 ;;
    9313efbb3c64108cb990271f3c9ba59821595a87e4f1b0c07d7538ab9a21786b)
        offset=374660
        patched=4ea4e9aa5146e2f4b7c003abd83fb8a4cf6edf2118e8a50c5a7f10ddf14013b0 ;;
    86ee414dfb314aa65414051eca76c498bdf4fa0ba5cc3f89d5be712773e153e5)
        # Build 1791328779: same MasterStream response constructor, verified
        # against its instructions and SteamChrome_MasterStream string.
        offset=372668
        patched=dd22bb0da0e636a52135aa7b4514abac0fa57799813ee301881559f2195f0171 ;;
    47e190a1aecfc48d31ef72eca97551db1e98e63726f6ac00f45a52e443ed80ed)
        # Public Beta 1791415817: MasterStream instructions and response-stream
        # string references match the verified Frame constructor above.
        offset=372668
        patched=cf90f845837c6edaddf8fb27dd136ffc6a4187ec8476b01ae1a0059e744b07ce ;;
    76a468fe3498eb85f40e66116eae865c6db2108534037ef3843090b45f8afca2)
        # Stable feed 1788652215: identical response-stream constructor;
        # the adjacent string reference resolves to SteamChrome_MasterStream.
        offset=373588
        patched=1f853fe9a31e09cb620a71c99bb2c773f32ea87d28fe26dc9e8621b900c2503e ;;
    *) echo 'Steam IPC timeout adaptation does not match this recovery build.' >&2; exit 1 ;;
esac
temporary="$binary.stearlight-ipc"
trap 'rm -f "$temporary"' EXIT
cp -p "$binary" "$temporary"
# mov w3, #500 -> mov w3, #30000, at the response stream constructor.
printf %s A6aOUg== | base64 -d |
    dd of="$temporary" bs=1 seek="$offset" conv=notrunc 2>/dev/null
if [ "$(sha256sum "$temporary" | cut -d ' ' -f 1)" != "$patched" ]; then
    echo 'Steam IPC timeout adaptation failed validation.' >&2
    exit 1
fi
mv "$temporary" "$binary"
echo 'STEARLIGHT ARM64 STEAM IPC REPLY TIMEOUT=30000ms'
