#!/usr/bin/env bash
# stearlight's in-tree gamescope-session-plus runtime.
#
# This is the small common session used by SteamOS/Armada: gamescope owns the
# application surfaces, publishes its XWayland/Wayland endpoints through a
# startup FIFO, then starts the selected session's runtime/client coordinator.

set -euo pipefail

# Match the upstream session's descriptor budget. Steam's WebHelper, CEF
# children, XWayland and the Gamescope control sockets are all descendants of
# this shell, so a low inherited limit can break the welcome pipeline after a
# successful first launch.
ulimit -n 524288 2>/dev/null || true

client=${1:-steam}
config_usr=/usr/share/gamescope-session-plus/sessions.d
config_etc=/etc/gamescope-session-plus/sessions.d
config_local=${XDG_CONFIG_HOME:-$HOME/.config}/gamescope-session-plus/sessions.d

short_session_recover() { :; }
post_gamescope_start() { :; }
post_client_shutdown() { :; }

# Keep the same configuration precedence as the upstream session package.
set -a
for config in "$config_usr/$client" "$config_etc/$client" \
             "$config_local/$client"; do
    if [[ -f "$config" ]]; then
        # shellcheck disable=SC1090
        source "$config"
    fi
done
for config in /etc/environment.d/*.conf \
             "$HOME"/.config/environment.d/*.conf; do
    if [[ -f "$config" ]]; then
        # shellcheck disable=SC1090
        source "$config"
    fi
done
set +a

: "${GAMESCOPE_BIN:=/usr/bin/gamescope}"
: "${SCREEN_WIDTH:=2880}"
: "${SCREEN_HEIGHT:=1600}"
: "${OUTPUT_WIDTH:=${STEARLIGHT_GAMESCOPE_OUTPUT_WIDTH:-$SCREEN_WIDTH}}"
: "${OUTPUT_HEIGHT:=${STEARLIGHT_GAMESCOPE_OUTPUT_HEIGHT:-$SCREEN_HEIGHT}}"
: "${INTERNAL_WIDTH:=$SCREEN_WIDTH}"
: "${INTERNAL_HEIGHT:=$SCREEN_HEIGHT}"
: "${NESTED_REFRESH:=60}"
: "${BACKEND:=drm}"
: "${XWAYLAND_COUNT:=2}"
: "${TOUCH_MODE:=4}"
: "${HIDE_CURSOR_DELAY_MS:=3000}"
: "${FADE_OUT_DURATION_MS:=200}"
if [[ -z "${CLIENTCMD:-}" ]]; then
    steam_frame_arg=
    if [[ "${STEARLIGHT_STEAM_FRAME:-1}" != 0 ]]; then
        steam_frame_arg=' -steamframe'
    fi
    CLIENTCMD="/usr/local/libexec/stearlight/launch-steam -gamepadui -steamos3 -steampal -steamdeck${steam_frame_arg}"
fi

export ENABLE_GAMESCOPE_WSI=1
export QT_QPA_PLATFORM=xcb
# These are the common SteamOS session defaults. In particular, do not make
# the generic WAYLAND_DISPLAY name point at Gamescope's private endpoint: the
# Steam client uses GAMESCOPE_WAYLAND_DISPLAY for that contract, while CEF
# should continue to create its WebHelper X11 surface on Gamescope's XWayland.
export vk_xwayland_wait_ready=false
export GAMESCOPE_DISABLE_ASYNC_FLIPS=1
export GAMESCOPE_MODE_SAVE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/gamescope/modes.cfg"
export GAMESCOPE_PATCHED_EDID_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/gamescope/edid.bin"
mkdir -p "$(dirname "$GAMESCOPE_MODE_SAVE_FILE")"
touch "$GAMESCOPE_MODE_SAVE_FILE" "$GAMESCOPE_PATCHED_EDID_FILE"

runtime_dir=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR must be set for gamescope}
tmpdir=$(mktemp -p "$runtime_dir" -d gamescope.XXXXXXX)
socket="$tmpdir/startup.socket"
stats="$tmpdir/stats.pipe"
mkfifo -- "$socket" "$stats"
export GAMESCOPE_STATS="$stats"

cleanup() {
    if [[ -n "${native_steamvr_pid:-}" ]]; then
        kill "$native_steamvr_pid" 2>/dev/null || true
        wait "$native_steamvr_pid" 2>/dev/null || true
    fi
    if [[ -n "${gamescope_pid:-}" ]]; then
        kill "$gamescope_pid" 2>/dev/null || true
        wait "$gamescope_pid" 2>/dev/null || true
    fi
    rm -rf -- "$tmpdir"
}
trap cleanup EXIT INT TERM

native_steamvr_pid=''

gamescope_args=(
    --backend "$BACKEND"
    -W "$OUTPUT_WIDTH" -H "$OUTPUT_HEIGHT"
    -w "$INTERNAL_WIDTH" -h "$INTERNAL_HEIGHT"
    -r "$NESTED_REFRESH"
    --xwayland-count "$XWAYLAND_COUNT"
    --default-touch-mode "$TOUCH_MODE"
    --hide-cursor-delay "$HIDE_CURSOR_DELAY_MS"
    --fade-out-duration "$FADE_OUT_DURATION_MS"
    --steam
    -R "$socket" -T "$stats"
)
if [[ "${STEARLIGHT_GAMESCOPE_FULLSCREEN:-0}" == 1 ]]; then
    gamescope_args+=(--fullscreen)
fi
if [[ "${STEARLIGHT_FRAME_VR_SESSION:-0}" == 1 ]]; then
    # Native Frame parameters; curvature is owned by SteamVR's overlay state.
    # Deferred initialization publishes XWayland before SteamVR starts.
    # A prestarted runtime can provide its texture modifiers immediately.
    if [[ "${STEARLIGHT_NATIVE_STEAMVR_PRESTARTED:-0}" != 1 ]]; then
        gamescope_args+=(--allow-deferred-backend)
    fi
    gamescope_args+=(
        --cursor-scale-height 720 --cursor-hotspot 5,3
        --framerate-limit 0 --max-scale 2
        --vr-overlay-enable-click-stabilization
        --vr-overlay-enable-control-bar
        --vr-overlay-enable-control-bar-keyboard
        --vr-overlay-icon /usr/share/steamos/steam_icon.png
        --vr-overlay-physical-width 2.67
        --vr-overlay-show-immediately --vr-session-manager
        --keep-alive --virtual-connector-strategy PerAppId
        --vr-overlay-key valve.steam.gamepadui.fallback
        --vr-app-overlay-key valve.steam.desktopgame
    )
fi
if [[ "${STEARLIGHT_GAMESCOPE_FORCE_COMPOSITION:-0}" == 1 ]]; then
    # QEMU's virtio-gpu scanout cannot import the Venus modifier used by the
    # Gamescope render target. Compose the final output into a scanout buffer.
    gamescope_args+=(--force-composition)
    printf '%s\n' 'STEARLIGHT GAMESCOPE FORCE_COMPOSITION=1' >&2
fi
printf 'STEARLIGHT GAMESCOPE CONFIG output=%sx%s internal=%sx%s backend=%s\n' \
    "$OUTPUT_WIDTH" "$OUTPUT_HEIGHT" "$INTERNAL_WIDTH" "$INTERNAL_HEIGHT" \
    "$BACKEND" >&2
if [[ -n "${CURSOR_FILE:-}" && -f "$CURSOR_FILE" ]]; then
    gamescope_args+=(--cursor "$CURSOR_FILE")
fi

gamescope_env=()
if [[ -n "${STEARLIGHT_GAMESCOPE_VK_ICD:-}" ]]; then
    # The compositor selects its own ICD. Steam's launcher may select an
    # x86 SteamRT ICD in the parent environment; keep that ABI out of the
    # compositor and use the guest's selected manifest.
    printf 'STEARLIGHT GAMESCOPE VULKAN ICD=%s\n' "$STEARLIGHT_GAMESCOPE_VK_ICD" >&2
    gamescope_env=(env VK_ICD_FILENAMES="$STEARLIGHT_GAMESCOPE_VK_ICD")
fi
"${gamescope_env[@]}" "$GAMESCOPE_BIN" "${gamescope_args[@]}" &
gamescope_pid=$!

# gamescope writes the X display and Wayland socket it created to the startup
# FIFO. Do not start Steam until both values have arrived; doing so is the
# this prevents Steam from starting before Gamescope has a real output.
response_x_display=''
response_wl_display=''
# Open the FIFO for both directions so a Gamescope startup failure cannot
# leave the shell blocked in open() before read's timeout takes effect.
exec {startup_fd}<>"$socket"
if ! read -r -t "${STEARLIGHT_GAMESCOPE_STARTUP_SECONDS:-30}" response_x_display response_wl_display <&"$startup_fd"; then
    echo 'gamescope-session-plus: gamescope did not become ready' >&2
    echo 'STEARLIGHT ARM64 GAMESCOPE STARTUP FAILED' >&2
    exit 1
fi
exec {startup_fd}>&-
if [[ -z "$response_x_display" || -z "$response_wl_display" ]]; then
    echo 'gamescope-session-plus: invalid gamescope startup response' >&2
    exit 1
fi
export DISPLAY="$response_x_display"
export GAMESCOPE_WAYLAND_DISPLAY="$response_wl_display"
# Pressure-vessel resolves a relative Gamescope name against its own runtime
# directory before entering the container. Publish the exact host socket too;
# this remains compatible with wl_display_connect() and lets pressure-vessel
# bind the socket even when /run/user is a symlink or a separately-mounted
# runtime directory.
gamescope_socket="$response_wl_display"
if [[ "$gamescope_socket" != /* ]]; then
    gamescope_socket="$runtime_dir/$gamescope_socket"
fi
export STEARLIGHT_STEAM_XWAYLAND_DISPLAY="$response_x_display"
export STEARLIGHT_STEAM_GAMESCOPE_WAYLAND_DISPLAY="$gamescope_socket"
export GAMESCOPE_WAYLAND_DISPLAY="$gamescope_socket"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=gamescope
socket_state=missing
if [[ -S "$gamescope_socket" ]]; then
    socket_state=present
fi
printf 'STEARLIGHT SESSION DISPLAY=%s GAMESCOPE=%s SOCKET=%s SOCKET_STATE=%s XDG_RUNTIME_DIR=%s\n' \
    "$response_x_display" "$GAMESCOPE_WAYLAND_DISPLAY" "$response_wl_display" \
    "$socket_state" "$runtime_dir" >&2
printf 'STEARLIGHT GAMESCOPE READY %sx%s @ %sHz\n' \
    "$SCREEN_WIDTH" "$SCREEN_HEIGHT" "$NESTED_REFRESH" >&2

post_gamescope_start

if command -v ibus-daemon >/dev/null 2>&1; then
    ibus-daemon -d -r --panel=disable --emoji-extension=disable || true
fi

# CLIENTCMD is intentionally a session variable, matching Armada's session
# contract. It can be replaced by /etc or ~/.config without rebuilding the
# image, while the default always starts Valve's real Gamepad UI. Start the
# Frame's CLIENTCMD starts SteamVR before Steam. Other profiles can start an
# optional SteamVR coordinator alongside the client. Valve owns the dashboard.
if [[ "${STEARLIGHT_FRAME_VR_SESSION:-0}" == 1 ]]; then
    printf '%s\n' 'STEARLIGHT FRAME SESSION COORDINATOR STARTING' >&2
else
    printf '%s\n' 'STEARLIGHT STEAM SESSION STARTING' >&2
fi
client_pid=''
eval "$CLIENTCMD" &
client_pid=$!
if [[ "${STEARLIGHT_NATIVE_STEAMVR:-0}" != 0 &&
      -x /usr/local/libexec/stearlight/steamvr-native ]]; then
    printf 'STEARLIGHT NATIVE STEAMVR STARTING root=%s display=%s\n' \
        "${STEARLIGHT_STEAMVR_ROOT:-/opt/steamvr}" "$DISPLAY" >&2
    /usr/local/libexec/stearlight/steamvr-native startup >&2 &
    native_steamvr_pid=$!
fi
wait "$client_pid"

post_client_shutdown

if [[ -e "${REBOOT_SENTINEL:-/tmp/steamos-reboot-sentinel}" ]]; then
    rm -f "$REBOOT_SENTINEL"
    reboot || true
elif [[ -e "${SHUTDOWN_SENTINEL:-/tmp/steamos-shutdown-sentinel}" ]]; then
    rm -f "$SHUTDOWN_SENTINEL"
    poweroff || true
fi
