#!/usr/bin/env bash
set -euo pipefail

export HOME=/var/home/stearlight
export XDG_RUNTIME_DIR=/run/user/1000
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=gamescope
export STEAM_GAMESCOPE_VRR_SUPPORTED=1
export STEAM_MULTIPLE_XWAYLANDS=1
export STEAM_USE_MANGOAPP=1

install -d -m 0700 -o stearlight -g stearlight "$XDG_RUNTIME_DIR"

# Keep Steam's first-run OOBE intact: it owns language, account and Wi-Fi
# setup through NetworkManager. No credentials or profile are preseeded.
exec gamescope --backend drm \
  --output-width 2880 --output-height 1600 \
  --nested-width 2880 --nested-height 1600 \
  --framerate 90 --adaptive-sync \
  -- /usr/libexec/stearlight/steam -gamepadui -steamos3 -steampal -steamdeck
