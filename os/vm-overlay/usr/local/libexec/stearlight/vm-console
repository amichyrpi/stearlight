#!/bin/sh
set -eu

# QEMU's Bochs/VGA scanout is backed by llvmpipe.  SDL's OpenGL renderer can
# create a context there but does not reliably present its swapchain to the
# Xorg framebuffer, leaving the guest black after the boot movie.  Use SDL's
# X11 software present path for the VM shell; the Pi production session never
# sources this VM-only supervisor and keeps its accelerated renderer.
export SDL_RENDER_DRIVER=${SVRT_VM_SDL_RENDER_DRIVER:-software}
# Select X11 explicitly for the SDL outer window.  A stale WAYLAND_DISPLAY can
# make SDL choose its Wayland driver even though the VM session is owned by
# Xorg :0; that creates a valid context but leaves QEMU's VGA scanout black.
export SDL_VIDEODRIVER=${SVRT_VM_SDL_VIDEODRIVER:-x11}
unset WAYLAND_DISPLAY

export XDG_RUNTIME_DIR=/run/user/1000
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=gamescope
export DISPLAY=:0
# Steam WebHelper initializes X/GTK input-method state before it creates the
# Gamepad UI surface.  The appliance has no login manager to provide a locale;
# use the libc-provided UTF-8 locale so XOpenIM and font setup are deterministic
# on every boot.
export LANG=${LANG:-C.UTF-8}
export LC_ALL=${LC_ALL:-C.UTF-8}
export LC_CTYPE=${LC_CTYPE:-C.UTF-8}
export SVRT_FONTCONFIG_FILE=${SVRT_FONTCONFIG_FILE:-/etc/fonts/stearlight-fonts.conf}
if [ -r "$SVRT_FONTCONFIG_FILE" ]; then
  export FONTCONFIG_FILE="$SVRT_FONTCONFIG_FILE"
  export FONTCONFIG_PATH=${SVRT_FONTCONFIG_PATH:-/etc/fonts}
fi
export SVRT_STEAM_HOME=/home/stearlight
export SVRT_STEAM_USER=stearlight
if [ -z "${XDG_CACHE_HOME:-}" ]; then
  export XDG_CACHE_HOME="$SVRT_STEAM_HOME/.cache"
fi
mkdir -p "$XDG_CACHE_HOME/fontconfig"
if [ "$XDG_CACHE_HOME" = "$SVRT_STEAM_HOME/.cache" ]; then
  chown stearlight:stearlight "$XDG_CACHE_HOME" "$XDG_CACHE_HOME/fontconfig"
fi
export SVRT_STEAM_BINARY=/usr/bin/steam
export SVRT_STEAM_LAUNCHER=/usr/local/libexec/stearlight/steam32-launch
export SVRT_STEAM_PREPARE=/usr/local/libexec/stearlight/steam-firstboot
export SVRT_STEAMUI_PATCH=/usr/local/libexec/stearlight/patch-steamui-network
# Steam verifies every WebUI chunk before starting; keep the optional network
# workaround off by default so it cannot force an update loop.
export SVRT_STEAMUI_PATCH_ENABLED=${SVRT_STEAMUI_PATCH_ENABLED:-0}
export SVRT_STEAM_RUNTIME_SEED=/usr/lib/steam
export SVRT_STEAM_RUNTIME_WATCH=/usr/local/libexec/stearlight/steam-runtime-watch
export SVRT_STEAM_SOFTWARE_GL=1
# VM boots are intentionally traceable: this overlay is only used by the
# disposable QEMU image and the serial log is the only diagnostic channel.
# Production Pi sessions keep the variable unset and do not inherit this
# extra output.
export SVRT_TRACE_VM_GPU=${SVRT_TRACE_VM_GPU:-1}
# The patched Steam Runtime selects an ABI-specific Mesa seed for each
# executable it launches.  Enabling this at the runtime boundary prevents the
# The standard multiarch DRI directories are ABI-aware and are populated by
# the VM seed step below.  Keep the private seed opt-in: steam.sh shares one
# environment between its 32-bit bootstrap and 64-bit WebHelper, so exporting
# the i386 seed here would make the latter open an ELF32 swrast module.
export SVRT_STEAM_USE_SEED_DRI=${SVRT_STEAM_USE_SEED_DRI:-0}
export SVRT_STEAM_FORCE_RUN=${SVRT_STEAM_FORCE_RUN:-0}
# Keep the bootstrap DRI override opt-in. The Steam process tree contains both
# 32-bit and 64-bit GL clients; a global i386 path makes the 64-bit branch load
# an ELF32 swrast module and abort. Mesa's multiarch search path is correct for
# both ABIs on the VM and on the Pi.
export SVRT_STEAM_BOOTSTRAP_DRI=${SVRT_STEAM_BOOTSTRAP_DRI:-}
# The stable Steam branch is entered through Valve's steam.sh bootstrap.  It
# performs the normal runtime hand-off and starts the Gamepad UI client after
# verification; the steamrt64 binary is only an explicit diagnostic path for
# non-stable beta branches.
export SVRT_STEAM_FORCE_DIRECT_CLIENT=${SVRT_STEAM_FORCE_DIRECT_CLIENT:-0}
# QEMU's software VGA session has no SteamOS portal broker for the private PID
# namespace used by pressure-vessel. That makes the Gamepad UI WebSocket peer
# fail its PID check even though CEF itself is healthy. Keep the VM on the
# host-PID WebHelper entry point by default; the production ARM session never
# sources vm-console and keeps Valve's normal pressure-vessel path.
export SVRT_STEAM_DIRECT_WEBHELPER=${SVRT_STEAM_DIRECT_WEBHELPER:-1}
# The x86 VM uses the same SteamRT3 client entry point as Armada's native
# launcher.  The public-beta tree contains the Gamepad UI and OOBE assets;
# opt into it explicitly instead of allowing the bootstrap's stable beta file
# to route back to the legacy 32-bit client.
# Keep the VM on the same stable SteamOS branch baked by
# preextract-steam-client.sh.  Rewriting this to publicbeta on every boot
# forces a full client update before the OOBE can create a surface.
export STEARLIGHT_STEAM_BETA=${STEARLIGHT_STEAM_BETA:-steamdeck_stable}
export SVRT_STEAM_UI_MODE=${SVRT_STEAM_UI_MODE:-gamepad}
# Load the guest DRM module before selecting the session.  A virtio-GPU device
# can use the DRM backend on a Linux host with a working Venus device.  Windows
# QEMU uses the deterministic VGA/SDL path below, which still runs the same
# SteamOS welcome pipeline through the software Gamescope build.
if command -v modprobe >/dev/null 2>&1; then
  modprobe drm 2>/dev/null || true
  modprobe bochs 2>/dev/null || modprobe bochs_drm 2>/dev/null || true
  modprobe virtio_pci 2>/dev/null || true
  modprobe virtio_gpu 2>/dev/null || true
fi

# Detect the actual DRM driver, not merely the presence of /dev/dri.  The
# Alpine lavapipe ICD is valid for Gamescope's nested SDL backend, but it is
# not a DRM scanout driver.  Prefer the real DRM path only when QEMU exposes a
# virtio GPU; otherwise use the bundled lavapipe-compatible Gamescope build.
# Explicit environment overrides remain authoritative for diagnostics.
vm_has_virtio_gpu=0
for drm_driver in /sys/class/drm/card*/device/driver; do
  [ -e "$drm_driver" ] || continue
  case "$(readlink "$drm_driver" 2>/dev/null || true)" in
    *virtio*) vm_has_virtio_gpu=1; break ;;
  esac
done
vm_has_software_gamescope=0
[ -x /usr/bin/gamescope-svrt ] && vm_has_software_gamescope=1
if [ -z "${SVRT_STEAM_COMPOSITOR:-}" ]; then
  if [ "$vm_has_virtio_gpu" = 1 ] &&
     [ -r /usr/share/vulkan/icd.d/virtio_icd.x86_64.json ]; then
    export SVRT_STEAM_COMPOSITOR=gamescope
  elif [ "$vm_has_software_gamescope" = 1 ]; then
    export SVRT_STEAM_COMPOSITOR=gamescope
  else
    export SVRT_STEAM_COMPOSITOR=weston
  fi
fi
if [ -z "${SVRT_STEAM_FORCE_WAYLAND:-}" ]; then
  if [ "$SVRT_STEAM_COMPOSITOR" = gamescope ]; then
    export SVRT_STEAM_FORCE_WAYLAND=1
  else
    export SVRT_STEAM_FORCE_WAYLAND=0
  fi
fi
if [ -z "${SVRT_VM_SESSION_MODE:-}" ]; then
  if [ "$SVRT_STEAM_COMPOSITOR" = gamescope ] &&
     [ "$vm_has_virtio_gpu" = 1 ]; then
    export SVRT_VM_SESSION_MODE=gamescope
  elif [ "$SVRT_STEAM_COMPOSITOR" = gamescope ] &&
       [ "$vm_has_software_gamescope" = 1 ]; then
    # Windows QEMU's Bochs/VGA device exposes a DRM node but not a Vulkan
    # physical device.  Nested Gamescope can therefore initialize Steam but
    # cannot present its SDL swapchain to the guest scanout.  Use the native
    # Stearlight shell bridge by default: Steam still runs the real Gamepad UI
    # on a private X11 display, while the shell presents the captured frame to
    # both stereo eyes.  An explicit SVRT_VM_SESSION_MODE=x11 remains available
    # for the flat direct-X11 diagnostic path.
    export SVRT_VM_SESSION_MODE=shell
  else
    export SVRT_VM_SESSION_MODE=shell
  fi
fi
if [ -z "${SVRT_USE_GAMESCOPE:-}" ]; then
  if [ "$SVRT_STEAM_COMPOSITOR" = gamescope ]; then
    export SVRT_USE_GAMESCOPE=1
  else
    export SVRT_USE_GAMESCOPE=0
  fi
fi
# The shell bridge is the VM's software stereo compositor.  Do not start a
# second nested Gamescope inside its private Xvfb display: that would either
# lose the X11 surface that the bridge captures or hit the same lavapipe
# presentation failure as the direct SDL path.  The explicit `gamescope`
# session mode remains available when a host provides real Vulkan/DRM.
if [ "$SVRT_VM_SESSION_MODE" = shell ]; then
  export SVRT_USE_GAMESCOPE=0
  export SVRT_STEAM_FORCE_WAYLAND=0
fi
if [ -z "${SVRT_VM_USE_DRM:-}" ]; then
  if [ "$vm_has_virtio_gpu" = 1 ]; then
    export SVRT_VM_USE_DRM=1
  else
    export SVRT_VM_USE_DRM=0
  fi
fi
if [ "${SVRT_TRACE_VM_GPU:-0}" != 0 ]; then
  printf 'STEARLIGHT VM GPU DEVICES: ' >>/dev/ttyS0
  if [ -d /dev/dri ]; then
    ls -1 /dev/dri >>/dev/ttyS0 2>&1 || true
  else
    printf '%s\n' none >>/dev/ttyS0
  fi
  printf 'STEARLIGHT VM FRAMEBUFFER DEVICES: ' >>/dev/ttyS0
  if ls /dev/fb* >/dev/null 2>&1; then
    ls -1 /dev/fb* >>/dev/ttyS0 2>&1 || true
  else
    printf '%s\n' none >>/dev/ttyS0
  fi
fi
if [ -n "${SVRT_VM_GAMESCOPE_BACKEND:-}" ]; then
  gamescope_backend=$SVRT_VM_GAMESCOPE_BACKEND
elif [ "${SVRT_VM_USE_DRM:-0}" = 1 ] && ls /dev/dri/card* >/dev/null 2>&1; then
  gamescope_backend=drm
else
  gamescope_backend=sdl
fi
# gamescope itself is the native Alpine/musl process. Select the ICD matching
# the DRM device; Steam's mixed 32/64-bit children choose their own runtime
# libraries only after gamescope has spawned the Valve client.
if [ "$vm_has_virtio_gpu" = 1 ] &&
   [ -r /usr/share/vulkan/icd.d/virtio_icd.x86_64.json ]; then
  export SVRT_GAMESCOPE_VK_ICD=/usr/share/vulkan/icd.d/virtio_icd.x86_64.json
else
  export SVRT_GAMESCOPE_VK_ICD=/usr/share/vulkan/icd.d/stearlight-alpine-lvp.json
fi
# The distro package is useful for hardware/DRM sessions, but the Windows
# QEMU fallback needs the lavapipe-compatible build.  Keep an explicit caller
# override intact so the Pi and Linux-host diagnostic paths can select another
# Gamescope binary.
if [ "$SVRT_STEAM_COMPOSITOR" = gamescope ] &&
   [ "$vm_has_virtio_gpu" != 1 ] &&
   [ "$vm_has_software_gamescope" = 1 ] &&
   [ -z "${GAMESCOPE_BIN:-}" ]; then
  export GAMESCOPE_BIN=/usr/bin/gamescope-svrt
fi
# Do not export a Steam ICD from the session supervisor. Steam starts a mixed
# 32/64-bit process tree (bootstrap, WebHelper and pressure-vessel); a single
# inherited manifest is ABI-specific and makes one side fail with
# VK_ERROR_INCOMPATIBLE_DRIVER. gamescope-session-plus receives the native
# Alpine ICD through SVRT_GAMESCOPE_VK_ICD, while steam32-launch selects an
# ABI-matched ICD only at an explicit direct-runtime boundary.
unset VK_ICD_FILENAMES VK_DRIVER_FILES
export SVRT_START_IN_STREAMING_MODE=0
export STEAM_BOOTSTRAP_CONFIG=/home/stearlight/.config/gamescope/bootstrap.cfg
export STEAMOS_STEAM_REBOOT_SENTINEL=/tmp/steamos-reboot-sentinel
export REBOOT_SENTINEL=$STEAMOS_STEAM_REBOOT_SENTINEL
export STEAMOS_STEAM_SHUTDOWN_SENTINEL=/tmp/steamos-shutdown-sentinel
export SHUTDOWN_SENTINEL=$STEAMOS_STEAM_SHUTDOWN_SENTINEL
export STEAM_GAMESCOPE=1
export STEAM_GAMESCOPE_WAYLAND=1
export STEAM_GAMEPADUI=1
export STEAMOS_OOBE=1
export STEAMOS_OOBE_IMAGE=1
export STEAM_GAMESCOPE_VRR_SUPPORTED=1
export STEAM_GAMESCOPE_HAS_TEARING_SUPPORT=1
export STEAM_GAMESCOPE_TEARING_SUPPORTED=1
export STEAM_GAMESCOPE_HDR_SUPPORTED=1
export STEAM_GAMESCOPE_DYNAMIC_FPSLIMITER=1
export STEAM_GAMESCOPE_NIS_SUPPORTED=1
export STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT=1
export STEAM_GAMESCOPE_COLOR_MANAGED=1
export STEAM_GAMESCOPE_VIRTUAL_WHITE=1
export STEAM_MANGOAPP_PRESETS_SUPPORTED=1
export STEAM_MANGOAPP_HORIZONTAL_SUPPORTED=1
export STEAM_USE_MANGOAPP=1
export STEAM_DISABLE_MANGOAPP_ATOM_WORKAROUND=1
export STEAM_USE_DYNAMIC_VRS=1
export STEAM_MULTIPLE_XWAYLANDS=1
export STEAM_ENABLE_VOLUME_HANDLER=1
export STEAM_ALLOW_DRIVE_UNMOUNT=1
export STEAM_ALLOW_DRIVE_ADOPT=1
export SRT_URLOPEN_PREFER_STEAM=1
export STEAM_DISABLE_AUDIO_DEVICE_SWITCHING=1
export QT_IM_MODULE=steam
export GTK_IM_MODULE=Steam
export XCURSOR_THEME=steam
export XCURSOR_SCALE=256
export GAMESCOPE_FALLBACK_APPID=0x41524d41
# QEMU's standard VGA/Bochs path cannot initialize Chromium's accelerated GPU
# process with the normal driver selection.  Keep Steam's compositor enabled,
# but use Steam's native `-cef-disable-gpu` option: the direct VM WebHelper
# entry point also adds Chromium's `--disable-gpu` after Steam reconstructs its
# child argv.  This is VM-only; the production Pi launcher never sources it.
# Keep the variable as an explicit override so a hardware test can still
# supply its own flags.
export SVRT_VM_CEF_ARGS="${SVRT_VM_CEF_ARGS:--cef-no-linux-angle -cef-disable-gpu -cef-disable-gpu-sandbox -cef-disable-sandbox -no-cef-sandbox -cef-disable-seccomp-sandbox}"
# Keep the VM's Steam client update path enabled.  The previous diagnostic
# defaults disabled bootstrap updates, so Steam downloaded the WebUI package
# but never applied it; after the next boot it was still running the old
# client and WebHelper could not complete the Gamepad UI handshake.  The
# network bridge patch is applied before launch and is deliberately kept
# outside Valve's replaceable tree, so normal Steam verification/update logic
# can run here.
export SVRT_VM_STEAM_UPDATE_ARGS="${SVRT_VM_STEAM_UPDATE_ARGS:-}"
# steam32-launch appends the VM CEF options at the final Steam boundary. Keep
# them out of CLIENTCMD so Steam does not receive every CEF switch twice.
# Match the SteamOS/Armada session contract exactly.  The old VM-only
# -720p/-fasthtml/VR switches were useful while debugging the updater, but
# they select a different WebUI bootstrap path and are not part of a normal
# Steam Deck welcome session.
export CLIENTCMD="/usr/local/libexec/stearlight/steam32-launch -gamepadui -steamos3 -steampal -steamdeck ${SVRT_VM_STEAM_UPDATE_ARGS}"
export CURSOR_FILE="$SVRT_STEAM_HOME/.local/share/Steam/tenfoot/resource/images/cursors/arrow.png"
# Keep a bounded X11 tree trace in the serial log while the standalone Steam
# bridge is being validated.  It is disabled for normal users by setting the
# variable to 0 in the service environment.
export SVRT_TRACE_STEAM_X11=${SVRT_TRACE_STEAM_X11:-1}
# Keep the small set of WebHelper logs visible on the VM serial console. This
# is VM-only diagnostics and is useful because the guest has no SSH session.
export SVRT_TRACE_STEAM_LOGS=${SVRT_TRACE_STEAM_LOGS:-1}
export SVRT_TRACE_STEAM_RUNTIME=${SVRT_TRACE_STEAM_RUNTIME:-1}
if [ "${SVRT_TRACE_STEAM_RUNTIME}" != 0 ]; then
  # Keep the pressure-vessel decision visible in the serial log while the VM
  # path is being brought up. These are no-op diagnostics when the runtime is
  # already healthy and are disabled by production callers.
  export PRESSURE_VESSEL_VERBOSE=1
  export STEAM_LINUX_RUNTIME_VERBOSE=1
  printf 'STEARLIGHT FONTCONFIG FILE=%s PATH=%s CACHE=%s\n' \
    "${FONTCONFIG_FILE:-}" "${FONTCONFIG_PATH:-}" "$XDG_CACHE_HOME" >>/dev/ttyS0
fi

# Keep the optional SteamRT marker available for beta diagnostics.  The normal
# stable launch below intentionally goes through steam.sh, which chooses the
# correct client branch from package/beta and only then starts WebHelper.
steam_data="$SVRT_STEAM_HOME/.local/share/Steam"
if [ -x "$steam_data/steamrt64/steam" ]; then
  # The marker is persistent Steam state.  Create it only when an image was
  # built without one; never overwrite Valve's branch choice on later boots.
  [ -e "$steam_data/.steam-enable-steamrt64-client" ] ||
    : > "$steam_data/.steam-enable-steamrt64-client"
  mkdir -p "$steam_data/package"
  [ -s "$steam_data/package/beta" ] ||
    printf '%s\n' "$STEARLIGHT_STEAM_BETA" > "$steam_data/package/beta"
fi

# The VM can be powered off while the shell is still running.  Some minimal
# boots do not mount /tmp as tmpfs, so Xorg's lock/socket can survive that
# abrupt stop and make the next session attach to (or reject) a stale display.
# Remove only the two displays owned by this service before starting Xorg.
rm -f /tmp/.X0-lock /tmp/.X8-lock /tmp/.X11-unix/X0 /tmp/.X11-unix/X8

# Steam's pressure-vessel/bwrap runtime requires unprivileged user
# namespaces.  Alpine's minimal VM kernel leaves the limits conservative (and
# some builds default the Debian compatibility knob to 0), which makes Steam
# stop at its own "user namespaces are required" prompt before WebUI starts.
# Apply the settings before dropping to the stearlight user.  Unknown knobs are
# harmless on kernels that do not expose them; the user.max_user_namespaces
# limit is the upstream control used by Alpine's linux-virt kernel.
if command -v sysctl >/dev/null 2>&1; then
  sysctl -w user.max_user_namespaces=1048576 2>/dev/null || true
  sysctl -w kernel.unprivileged_userns_clone=1 2>/dev/null || true
  sysctl -w kernel.apparmor_restrict_unprivileged_userns=0 2>/dev/null || true
  # CEF/WebHelper reserves a large virtual address space.  These are safe
  # defaults for the sealed VM and avoid mmap(ENOMEM) when pressure-vessel
  # starts the 64-bit helper; kernels without a knob simply ignore it.
  sysctl -w vm.max_map_count=2147483642 2>/dev/null || true
  sysctl -w vm.overcommit_memory=1 2>/dev/null || true
  sysctl -w vm.overcommit_ratio=100 2>/dev/null || true
fi

# OpenRC/supervise-daemon may inherit a conservative address-space limit from
# the initramfs.  Chromium/CEF needs a large sparse virtual address range,
# even though it commits little physical memory.  Lift only the limits for
# this VM session; the production service remains governed by its unit limits.
ulimit -v unlimited 2>/dev/null || true
ulimit -m unlimited 2>/dev/null || true
ulimit -d unlimited 2>/dev/null || true
ulimit -l unlimited 2>/dev/null || true
ulimit -n 1048576 2>/dev/null || true

if [ "${SVRT_TRACE_VM_GPU:-0}" != 0 ]; then
  {
    printf '%s\n' 'STEARLIGHT VM MEMORY LIMITS BEGIN'
    ulimit -a
    printf '%s\n' '--- /proc/meminfo ---'
    sed -n '1,12p' /proc/meminfo
    printf '%s\n' '--- vm knobs ---'
    for knob in max_map_count overcommit_memory overcommit_ratio; do
      printf '%s=' "$knob"
      cat "/proc/sys/vm/$knob" 2>/dev/null || true
    done
    printf '%s\n' '--- shared memory ---'
    df -h /dev/shm 2>/dev/null || true
    printf '%s\n' 'STEARLIGHT VM MEMORY LIMITS END'
  } >>/dev/ttyS0 2>&1 || true
fi

# Chromium/CEF uses shared-memory mappings for compositor surfaces and its
# offscreen JS context.  The minimal VM kernel otherwise mounts /dev/shm with
# a tiny default, which presents as repeated mmap(ENOMEM) and a blank Steam
# WebHelper even when the guest has free RAM.  Give the test session a bounded
# tmpfs large enough for those surfaces without reserving physical memory.
if command -v mount >/dev/null 2>&1; then
  if mountpoint -q /dev/shm 2>/dev/null; then
    mount -o remount,size=${SVRT_VM_SHM_SIZE:-2G} /dev/shm 2>/dev/null || true
  else
    mount -t tmpfs -o mode=1777,size=${SVRT_VM_SHM_SIZE:-2G} tmpfs /dev/shm 2>/dev/null || true
  fi
fi

# pressure-vessel's capsule loader requires a host ldconfig cache. Keep this
# repair in the privileged VM session as well as the image build: it makes an
# older VM overlay recover without another multi-stage build.
if [ ! -s /var/cache/ldconfig/ld.so.cache ]; then
  steam_cache=$(find "$SVRT_STEAM_HOME/.local/share/Steam" -type f \
    -path '*/files/etc/ld.so.cache' -print -quit 2>/dev/null || true)
  if [ -n "$steam_cache" ]; then
    mkdir -p /var/cache/ldconfig 2>/dev/null || true
    cp -L "$steam_cache" /var/cache/ldconfig/ld.so.cache 2>/dev/null || true
  fi
fi

# The Alpine compatibility layer may ship empty placeholder DRI directories.
# Pressure-vessel discovers host GL drivers before it starts WebHelper; if the
# x86_64 directory is empty it falls through to the valid i386 swrast module
# and the CEF process aborts with ELFCLASS32. Populate only an absent/empty
# swrast entry from the ABI-matched Steam Runtime seed.
seed_host_dri() {
  abi=$1
  target=$2
  source="$SVRT_STEAM_RUNTIME_SEED/stearlight_libs_${abi}/dri"
  if [ ! -d "$source" ]; then
    source=$(find "$SVRT_STEAM_HOME/.local/share/Steam/ubuntu12_32/steam-runtime" \
      -path "*/stearlight_libs_${abi}/dri" -type d -print -quit 2>/dev/null || true)
  fi
  [ -d "$source" ] || return 0
  magic=
  if [ -r "$target/swrast_dri.so" ]; then
    magic=$(dd if="$target/swrast_dri.so" bs=1 count=4 2>/dev/null |
      od -An -tx1 | tr -d '[:space:]')
  fi
  case "$magic" in
    7f454c46*) return 0 ;;
  esac
  mkdir -p "$target" 2>/dev/null || return 0
  cp -a "$source"/. "$target"/ 2>/dev/null || true
}

# Steam may replace ubuntu12_32/steam-runtime while applying its first client
# update.  Keep an ABI-matched copy outside that replaceable tree so the
# watcher can restore Mesa modules (and their matching glibc dependencies)
# after the update completes.  Extract only the small Stearlight seed from
# Valve's bootstrap archive; do not unpack a second full Steam runtime.
ensure_steam_runtime_seed() {
  abi=$1
  target="$SVRT_STEAM_RUNTIME_SEED/stearlight_libs_${abi}"
  archive=/usr/lib/steam/bootstraplinux_ubuntu12_32.tar.xz
  [ -r "$target/dri/swrast_dri.so" ] && return 0
  [ -r "$archive" ] || return 0
  tmp="/var/lib/stearlight/.steam-seed.$$"
  rm -rf "$tmp"
  mkdir -p "$tmp"
  path="./ubuntu12_32/steam-runtime/stearlight_libs_${abi}"
  if tar -xJf "$archive" -C "$tmp" "$path" 2>/dev/null; then
    extracted="$tmp/ubuntu12_32/steam-runtime/stearlight_libs_${abi}"
    if [ -d "$extracted" ]; then
      mkdir -p "$target"
      cp -a "$extracted"/. "$target"/ 2>/dev/null || true
    fi
  fi
  rm -rf "$tmp"
}
ensure_steam_runtime_seed 32
ensure_steam_runtime_seed 64
seed_host_dri 32 /usr/lib/i386-linux-gnu/dri
seed_host_dri 64 /usr/lib/x86_64-linux-gnu/dri

# The VM enters the gamescope session directly, so there is no C-bridge
# callback to run the common first-boot preparation hook.  Run it explicitly
# as root before dropping to the Steam user: the extracted Steam Runtime in a
# sealed image is root-owned, and the ABI repair must finish before Steam
# starts.  Hand ownership back afterward so Valve can update the per-user
# tree normally.
if [ -x "$SVRT_STEAM_PREPARE" ]; then
  "$SVRT_STEAM_PREPARE" >>/dev/ttyS0 2>&1 || true
  if [ "${SVRT_STEAMUI_PATCH_ENABLED:-0}" = 1 ] &&
     [ -x "$SVRT_STEAMUI_PATCH" ]; then
    "$SVRT_STEAMUI_PATCH" >>/dev/ttyS0 2>&1 || true
  fi
  chown -R stearlight:stearlight "$SVRT_STEAM_HOME/.local/share/Steam" \
    "$SVRT_STEAM_HOME/.steam" "$SVRT_STEAM_HOME/.config" \
    "$SVRT_STEAM_HOME/.cache" 2>/dev/null || true
fi

# Steam's IPC and WebUI bind loopback sockets (including the local remote
# debugger). Minimal Alpine boots can leave `lo` down until a desktop network
# manager starts, so initialize it before launching the client.
if command -v ip >/dev/null 2>&1; then
  ip link set lo up 2>/dev/null || true
  ip addr add 127.0.0.1/8 dev lo 2>/dev/null || true
  ip -6 addr add ::1/128 dev lo 2>/dev/null || true
fi
# Valve's WebUI transport uses this hostname for the local-only websocket.
# Public DNS normally maps it to loopback, but a minimal/offline Alpine boot
# must not depend on DNS being ready before Steam starts.
if [ -w /etc/hosts ] && ! grep -Eq '^[[:space:]]*127\.0\.0\.1[[:space:]].*([[:space:]]|^)steamloopback\.host([[:space:]]|$)' /etc/hosts; then
  printf '%s\n' '127.0.0.1 steamloopback.host' >>/etc/hosts
fi

mkdir -p /home/stearlight/.steam /home/stearlight/.local/share
# Steam's client and pressure-vessel logger expect this directory to exist
# before the first WebHelper/update process starts.  A sealed image otherwise
# reaches Steam's updater and then aborts in CFrameFunctionMgr while trying to
# initialize its assertion dump path.
mkdir -p "$steam_data/logs"
ln -sfn /home/stearlight/.local/share/Steam /home/stearlight/.steam/root
ln -sfn /home/stearlight/.local/share/Steam /home/stearlight/.steam/steam
chown -R stearlight:stearlight /home/stearlight/.steam /home/stearlight/.local

xorg_pid=
window_clamp_pid=
if [ "$SVRT_VM_SESSION_MODE" != gamescope ] || [ "$gamescope_backend" != drm ]; then
  # SDL is retained only as a hypervisor fallback.  The normal VM and Pi
  # paths run gamescope directly on DRM/KMS, which avoids a nested X server.
  Xorg :0 -ac -keeptty -noreset -nolisten tcp vt1 \
    >>/dev/ttyS0 2>&1 &
  xorg_pid=$!
  attempt=0
  while [ ! -S /tmp/.X11-unix/X0 ] && [ "$attempt" -lt 100 ]; do
    kill -0 "$xorg_pid" 2>/dev/null || {
      printf '%s\n' 'Xorg exited before creating display :0' \
        >>/dev/ttyS0
      exit 1
    }
    attempt=$((attempt + 1))
    sleep 0.1
  done
  [ -S /tmp/.X11-unix/X0 ] || exit 1
fi

# A native Gamescope/DRM diagnostic must show the boot movie before Gamescope
# takes DRM ownership.  The normal VM shell owns boot.mkv and loop.mkv in one
# process; running a boot-only shell there would show the boot movie twice.
if [ "${STEARLIGHT_BOOT_SCREEN:-1}" = 1 ] &&
   [ "$SVRT_VM_SESSION_MODE" = gamescope ] &&
   [ "$gamescope_backend" = drm ] &&
   [ -x /usr/bin/stearlight-shell ]; then
  printf '%s\n' 'STEARLIGHT VM BOOT SCREEN STARTING' >>/dev/ttyS0
  openvt -c 1 -f -s -w -- su-exec stearlight env \
    SDL_VIDEODRIVER=KMSDRM SVRT_BOOT_ONLY=1 \
    /usr/bin/stearlight-shell >>/dev/ttyS0 2>&1 || true
  printf '%s\n' 'STEARLIGHT VM BOOT SCREEN COMPLETE' >>/dev/ttyS0
fi

# QEMU's software-VGA diagnostic path has no window manager.  CEF uses an
# INT_MIN position as a request for WM placement; without a WM Steam's login
# window is mapped at an enormous unsigned coordinate and never reaches the
# framebuffer.  Center those VM-only windows after X11 is ready.  Gamescope
# and the production Pi path do their own surface placement and never start
# this helper.
if [ "$SVRT_VM_SESSION_MODE" = x11 ] &&
   [ "${SVRT_VM_X11_WINDOW_CLAMP:-1}" = 1 ] &&
   [ -x /usr/local/libexec/stearlight/x11-window-clamp ]; then
  su-exec stearlight env DISPLAY=:0 \
    SVRT_X11_CLAMP_SECONDS="${SVRT_VM_X11_CLAMP_SECONDS:-0}" \
    SVRT_X11_CLAMP_DEBUG="${SVRT_VM_X11_CLAMP_DEBUG:-0}" \
    SVRT_X11_CLAMP_FULLSCREEN="${SVRT_VM_X11_CLAMP_FULLSCREEN:-1}" \
    /usr/local/libexec/stearlight/x11-window-clamp >>/dev/ttyS0 2>&1 &
  window_clamp_pid=$!
fi

printf '%s\n' 'STEARLIGHT VM DISPLAY READY 2880x1600 @ 60Hz' >>/dev/ttyS0
if [ -n "$xorg_pid" ]; then
  # Xorg creates its socket before modesetting has completed.  A synchronous
  # xrandr query at that point can wait forever on the server and prevent the
  # Steam session from ever starting.  Keep the query diagnostic-only and
  # bounded; it must never be part of the launch critical path.
  if command -v timeout >/dev/null 2>&1; then
    timeout 5s env DISPLAY=:0 xrandr --current >>/dev/ttyS0 2>&1 || true
  else
    ( DISPLAY=:0 xrandr --current >>/dev/ttyS0 2>&1 || true ) &
  fi
  if [ "${SVRT_TRACE_VM_GPU:-0}" != 0 ]; then
    printf '%s\n' 'STEARLIGHT XORG LOG BEGIN' >>/dev/ttyS0
    sed -n '/(II) modeset/,/(II) Initializing extension GLX/p' \
      /var/log/Xorg.0.log >>/dev/ttyS0 2>&1 || true
    printf '%s\n' 'STEARLIGHT XORG LOG END' >>/dev/ttyS0
  fi
fi

# Let dhcpcd obtain the user-mode NAT lease before Steam performs its first
# manifest request in the native Gamescope path.  The shell bridge can start
# immediately and lets Steam wait for networking behind the boot/loop movies;
# blocking there made the VM show a static framebuffer during its boot check.
if [ "$SVRT_VM_SESSION_MODE" = gamescope ]; then
  attempt=0
  while [ "$attempt" -lt 15 ]; do
    if ip route show default 2>/dev/null | grep -q default; then
      break
    fi
    attempt=$((attempt + 1))
    sleep 1
  done
fi

# Keep this supervisor process alive for the lifetime of the X server.  The
# previous `exec` form orphaned Xorg whenever the shell exited (for example
# after an X11 capture error); OpenRC then respawned a second session against
# the still-running display and produced an endless "server is already active"
# loop.  Waiting here gives the trap a chance to tear down both processes in
# the correct order before OpenRC retries.
shell_pid=
watcher_pid=
steam_log_tail_pid=
steam_process_trace_pid=
cleanup_session() {
  if [ -n "${shell_pid:-}" ]; then
    kill "$shell_pid" 2>/dev/null || true
    wait "$shell_pid" 2>/dev/null || true
  fi
  if [ -n "${watcher_pid:-}" ]; then
    kill "$watcher_pid" 2>/dev/null || true
    wait "$watcher_pid" 2>/dev/null || true
  fi
  if [ -n "${steam_log_tail_pid:-}" ]; then
    kill "$steam_log_tail_pid" 2>/dev/null || true
    wait "$steam_log_tail_pid" 2>/dev/null || true
  fi
  if [ -n "${steam_process_trace_pid:-}" ]; then
    kill "$steam_process_trace_pid" 2>/dev/null || true
    wait "$steam_process_trace_pid" 2>/dev/null || true
  fi
  if [ -n "${window_clamp_pid:-}" ]; then
    kill "$window_clamp_pid" 2>/dev/null || true
    wait "$window_clamp_pid" 2>/dev/null || true
  fi
  if [ -n "${xorg_pid:-}" ]; then
    kill "$xorg_pid" 2>/dev/null || true
    wait "$xorg_pid" 2>/dev/null || true
  fi
}
trap cleanup_session EXIT INT TERM

# Steam replaces parts of ubuntu12_32/steam-runtime during its first client
# update. It can briefly leave zero-byte compatibility libraries behind while
# the 32-bit bootstrap is already creating its GLX window. Keep the small
# ABI-repair loop alive before Steam starts, so that replacement is repaired
# during that window instead of after the client has crashed.
if [ -x "$SVRT_STEAM_RUNTIME_WATCH" ]; then
  su-exec stearlight env \
    HOME="$SVRT_STEAM_HOME" \
    SVRT_STEAM_RUNTIME_SEED="$SVRT_STEAM_RUNTIME_SEED" \
    "$SVRT_STEAM_RUNTIME_WATCH" >>/dev/ttyS0 2>&1 &
  watcher_pid=$!
fi

set +e
if [ "$SVRT_VM_SESSION_MODE" = gamescope ] &&
   [ -x /usr/bin/gamescope-session-plus ]; then
  # This is the real Armada/SteamOS session path.  gamescope owns the X11
  # output and publishes a Wayland socket before the Steam client starts, so
  # the VM framebuffer is the Steam welcome page rather than the C bridge's
  # placeholder/background capture.
  export BACKEND=$gamescope_backend
export SCREEN_WIDTH=2880
export SCREEN_HEIGHT=1600
  # Both QEMU modes use the native target size.  The VGA/SDL fallback is
  # software-rendered, but the host VM has enough memory for the full surface
  # and this keeps the captured image aligned with the SteamOS reference UI.
  if [ "$gamescope_backend" = drm ]; then
    export SVRT_GAMESCOPE_OUTPUT_WIDTH=${SVRT_VM_OUTPUT_WIDTH:-2880}
    export SVRT_GAMESCOPE_OUTPUT_HEIGHT=${SVRT_VM_OUTPUT_HEIGHT:-1600}
  else
    export SVRT_GAMESCOPE_OUTPUT_WIDTH=${SVRT_VM_OUTPUT_WIDTH:-2880}
    export SVRT_GAMESCOPE_OUTPUT_HEIGHT=${SVRT_VM_OUTPUT_HEIGHT:-1600}
  fi
export INTERNAL_WIDTH=${SVRT_VM_INTERNAL_WIDTH:-$SVRT_GAMESCOPE_OUTPUT_WIDTH}
export INTERNAL_HEIGHT=${SVRT_VM_INTERNAL_HEIGHT:-$SVRT_GAMESCOPE_OUTPUT_HEIGHT}
export NESTED_REFRESH=60
  su-exec stearlight env USER=stearlight LOGNAME=stearlight HOME="$SVRT_STEAM_HOME" \
    dbus-launch --exit-with-session \
    /usr/bin/gamescope-session-plus steam \
    2>>/dev/ttyS0 &
elif [ "$SVRT_VM_SESSION_MODE" = x11 ]; then
  # A software-only hypervisor can expose a working X11 scanout even when
  # lavapipe cannot allocate gamescope's Vulkan presentation images.  Keep
  # this as an explicit VM diagnostic mode: it still launches Valve's real
  # Gamepad UI, while the Pi production session remains gamescope/DRM.
  unset WAYLAND_DISPLAY GAMESCOPE_WAYLAND_DISPLAY
  export XDG_SESSION_TYPE=x11
  # The nested X11 path is deliberately not a Gamescope session. Leaving
  # these SteamOS compositor flags enabled makes the Gamepad UI wait for a
  # Wayland transport that does not exist on QEMU's software VGA output; the
  # webhelper then opens but rejects every loopback UI connection. Keep the
  # Gamepad UI itself enabled while advertising the actual X11 session.
  export STEAM_GAMESCOPE=0
  export STEAM_GAMESCOPE_WAYLAND=0
  export XDG_CURRENT_DESKTOP=steam
  steam_ui_args='-gamepadui -steamos3 -steampal -steamdeck'
  if [ "${SVRT_VM_STEAM_UI_MODE:-gamepad}" = classic ]; then
    # Classic ten-foot Steam uses the ordinary X11 WebHelper surface and is
    # the only Steam UI that can be presented by QEMU's software VGA path.
    # It still runs Valve's real client and first-run language/network/sign-in
    # pipeline; production Pi sessions retain the Gamepad UI branch.
    steam_ui_args='-tenfoot -steamos'
  elif [ "${SVRT_VM_STEAM_UI_MODE:-gamepad}" = legacy ]; then
    # Last-resort X11 diagnostic mode. The old VGUI path creates a regular
    # sized WebHelper window and proves the guest scanout independently of
    # the Gamescope-specific Gamepad UI transport.
    steam_ui_args='-vgui'
  fi
  printf '%s\n' 'STEARLIGHT STEAM SESSION STARTING' >>/dev/ttyS0
  su-exec stearlight env USER=stearlight LOGNAME=stearlight HOME="$SVRT_STEAM_HOME" \
    dbus-launch --exit-with-session \
    "$SVRT_STEAM_LAUNCHER" $steam_ui_args \
    ${SVRT_VM_STEAM_UPDATE_ARGS} \
    2>>/dev/ttyS0 &
else
  # Explicit diagnostic fallback: the standalone shell captures an X11
  # surface into its stereo renderer when gamescope cannot run on a host.
  su-exec stearlight env USER=stearlight LOGNAME=stearlight HOME="$SVRT_STEAM_HOME" \
    dbus-launch --exit-with-session \
    /usr/bin/stearlight-shell \
    2>>/dev/ttyS0 &
fi
shell_pid=$!
if [ "${SVRT_TRACE_STEAM_PROCESSES:-0}" != 0 ]; then
  # The WebUI transport log reports the PID that owns the connecting socket.
  # Keep a short process/namespace sample in the serial log so a VM-only
  # transport failure can be diagnosed without attaching a debugger.  Do not
  # dump the full environment: Steam tokens and account data may be present.
  (
    trace_remaining=${SVRT_TRACE_STEAM_PROCESS_SECONDS:-20}
    while [ "$trace_remaining" -gt 0 ] && kill -0 "$shell_pid" 2>/dev/null; do
      printf '%s\n' 'STEARLIGHT STEAM PROCESS TRACE BEGIN' >>/dev/ttyS0
      for process_dir in /proc/[0-9]*; do
        [ -r "$process_dir/cmdline" ] || continue
        process_pid=${process_dir##*/}
        process_cmd=$(tr '\000' ' ' <"$process_dir/cmdline" 2>/dev/null || true)
        case "$process_cmd" in
          *steamwebhelper*|*steamrt64/steam*|*steam.sh*)
            process_ppid=$(awk '/^PPid:/ {print $2; exit}' \
              "$process_dir/status" 2>/dev/null || true)
            process_nspid=$(awk '/^NSpid:/ {$1=""; sub(/^[[:space:]]+/, ""); print; exit}' \
              "$process_dir/status" 2>/dev/null || true)
            process_uid=$(awk '/^Uid:/ {print $2; exit}' \
              "$process_dir/status" 2>/dev/null || true)
            process_pid_ns=$(readlink "$process_dir/ns/pid" 2>/dev/null || true)
            process_net_ns=$(readlink "$process_dir/ns/net" 2>/dev/null || true)
            process_sockets=$(find "$process_dir/fd" -maxdepth 1 -type l \
              -exec readlink {} \; 2>/dev/null |
              grep -o 'socket:\[[0-9]*\]' | tr '\n' ',' || true)
            printf 'STEARLIGHT PROCESS pid=%s ppid=%s nspid=%s uid=%s pidns=%s netns=%s sockets=%s cmd=%s\n' \
              "$process_pid" "$process_ppid" "$process_nspid" "$process_uid" \
              "$process_pid_ns" "$process_net_ns" "$process_sockets" "$process_cmd" >>/dev/ttyS0
            ;;
        esac
      done
      printf '%s\n' 'STEARLIGHT STEAM PROCESS TRACE END' >>/dev/ttyS0
      trace_remaining=$((trace_remaining - 1))
      sleep 1
    done
  ) &
  steam_process_trace_pid=$!
fi
if [ "${SVRT_TRACE_STEAM_LOGS:-0}" != 0 ]; then
  # Steam creates these files only after the updater hands off to WebHelper.
  # Report appended log data without making logging part of the launch path.
  (
    trace_state=/tmp/stearlight-steam-log-tail
    mkdir -p "$trace_state"
    while kill -0 "$shell_pid" 2>/dev/null; do
      for steam_log in \
        "$steam_data/logs/steamwebhelper.log" \
        "$steam_data/logs/webhelper-linux.txt" \
        "$steam_data/logs/webhelper.txt" \
        "$steam_data/logs/transport_steamui.txt" \
        "$steam_data/logs/steamui.txt" \
        "$steam_data/logs/steamui_login.txt" \
        "$steam_data/logs/connection_log.txt" \
        "$steam_data/logs/cef_log.txt" \
        "$steam_data/logs/bootstrap_log.txt" \
        "$steam_data/logs/transport_client.txt" \
        "$steam_data/logs/webhelper_js.txt"; do
        [ -f "$steam_log" ] || continue
        steam_log_name=${steam_log##*/}
        steam_log_size=$(wc -c <"$steam_log" 2>/dev/null | tr -d '[:space:]')
        steam_log_state="$trace_state/$steam_log_name.size"
        previous_size=$(cat "$steam_log_state" 2>/dev/null || true)
        if [ "$steam_log_size" != "$previous_size" ]; then
          printf 'STEARLIGHT STEAM LOG %s BEGIN\n' "$steam_log_name" >>/dev/ttyS0
          tail -n 100 "$steam_log" >>/dev/ttyS0 2>&1 || true
          printf 'STEARLIGHT STEAM LOG %s END\n' "$steam_log_name" >>/dev/ttyS0
          printf '%s\n' "$steam_log_size" >"$steam_log_state"
        fi
      done
      sleep 5
    done
  ) &
  steam_log_tail_pid=$!
fi
wait "$shell_pid"
shell_status=$?
set -e
shell_pid=
if [ -n "$xorg_pid" ]; then
  kill "$xorg_pid" 2>/dev/null || true
  wait "$xorg_pid" 2>/dev/null || true
fi
exit "$shell_status"
