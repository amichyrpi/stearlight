+static void ReleaseIdleDeviceHosts() {
+    // This private prefix uses native OpenVR input. Disabled kernel services
+    // can leave Wine's device containers alive with no service to host.
+    SC_HANDLE manager=OpenSCManagerA(nullptr,nullptr,SC_MANAGER_ENUMERATE_SERVICE);
+    if(!manager)return;
+    BYTE buffer[65536];DWORD needed=0,count=0,resume=0;
+    BOOL empty=EnumServicesStatusExA(manager,SC_ENUM_PROCESS_INFO,SERVICE_DRIVER,
+        SERVICE_ACTIVE,buffer,sizeof(buffer),&needed,&count,&resume,nullptr)&&count==0;
+    CloseServiceHandle(manager);
+    if(!empty)return;
+    HANDLE snapshot=CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS,0);
+    if(snapshot==INVALID_HANDLE_VALUE)return;
+    PROCESSENTRY32W entry{};entry.dwSize=sizeof(entry);unsigned released=0;
+    if(Process32FirstW(snapshot,&entry))do {
+        // Wine's process list is scoped to this prefix, not other games.
+        if(_wcsicmp(entry.szExeFile,L"winedevice.exe"))continue;
+        HANDLE process=OpenProcess(PROCESS_TERMINATE,FALSE,entry.th32ProcessID);
+        if(process){if(TerminateProcess(process,0))++released;CloseHandle(process);}
+    }while(Process32NextW(snapshot,&entry));
+    CloseHandle(snapshot);
+    std::cout<<"Quest idle device hosts released: "<<released<<std::endl;
+}
+#endif
