+void RpcSystem::CancelPendingCalls() {
+ auto &self=GetInstance();
+ std::lock_guard lock(self.pending_calls_mutex_);
+ self.calls_cancelled_=true;
+ for(auto const &[id,call]:self.pending_calls_) {
+  std::lock_guard call_lock(call->mtx);
+  call->completed=true;call->cv.notify_one();
+ }
+ self.pending_calls_.clear();
+}
