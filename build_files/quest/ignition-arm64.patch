diff --git a/projects/common/quest_pose_channel.h b/projects/common/quest_pose_channel.h
new file mode 100644
index 0000000..db5cd0d
--- /dev/null
+++ b/projects/common/quest_pose_channel.h
@@ -0,0 +1,126 @@
+#pragma once
+#include <openvr_driver.h>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstring>
+#include <mutex>
+#include <new>
+#include <thread>
+#include "../ignition_bridge/shared_memory_block.h"
+
+// Align each device's deadline to the same 120 Hz clock. A thread publishing
+// eight devices waits once per frame, rather than eight times per frame.
+class QuestFramePacer {
+    using Clock = std::chrono::steady_clock;
+    std::array<Clock::time_point, vr::k_unMaxTrackedDeviceCount> next{};
+public:
+    void Wait(unsigned device, uint32_t period = 8333333) {
+        if (device >= next.size()) return;
+        if (Clock::now() < next[device]) std::this_thread::sleep_until(next[device]);
+        if (period < 8333333 || period > 33333333) period = 8333333;
+        auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now().time_since_epoch()).count();
+        next[device] = Clock::time_point(std::chrono::duration_cast<Clock::duration>(
+            std::chrono::nanoseconds((ns / period + 1) * period)));
+    }
+};
+
+// The Windows producer publishes complete latest poses. The native provider
+// drains them without per-tracker RPCs, allocations or waits for Wine.
+class QuestPoseChannel {
+    struct Snapshot {
+        uint64_t timestamp;
+        vr::DriverPose_t pose;
+    };
+    static_assert(sizeof(Snapshot) == 288 && offsetof(Snapshot, pose) == 8);
+    static constexpr unsigned word_count = sizeof(Snapshot) / sizeof(uint32_t);
+    struct alignas(64) Slot {
+        std::atomic<uint32_t> sequence{0};
+        uint32_t reserved = 0;
+        std::atomic<uint32_t> words[word_count]{};
+    };
+    struct Data {
+        uint32_t version = 1;
+        uint32_t pose_size = sizeof(vr::DriverPose_t);
+        std::atomic<uint32_t> frame_period{8333333};
+        Slot slots[vr::k_unMaxTrackedDeviceCount];
+    };
+    static_assert(std::atomic<uint32_t>::is_always_lock_free);
+    static_assert(offsetof(Slot, words) == 8);
+    static_assert(sizeof(vr::DriverPose_t) == 280 && sizeof(Slot) == 320);
+    ignition::ipc::SharedMemoryBlock mapping;
+    Data *data = nullptr;
+    std::mutex lifetime;
+    QuestFramePacer pacer;
+    std::array<uint32_t, vr::k_unMaxTrackedDeviceCount> consumed{};
+public:
+    bool Create(const std::string &name) {
+        std::lock_guard guard(lifetime);
+        if (!mapping.Create(name + "_poses_v1", sizeof(Data))) return false;
+        data = new (mapping.GetPointer()) Data();
+        consumed.fill(0);
+        return true;
+    }
+    bool Open(const std::string &name) {
+        std::lock_guard guard(lifetime);
+        if (!mapping.Open(name + "_poses_v1", sizeof(Data))) return false;
+        auto *value = static_cast<Data *>(mapping.GetPointer());
+        if (value->version != 1 || value->pose_size != sizeof(vr::DriverPose_t)) {
+            mapping.Close(); return false;
+        }
+        data = value;
+        consumed.fill(0);
+        return true;
+    }
+    void Close() {
+        std::lock_guard guard(lifetime);
+        data = nullptr;
+        mapping.Close();
+    }
+    void SetFramePeriod(uint32_t period) {
+        std::lock_guard guard(lifetime);
+        if (data) data->frame_period.store(period, std::memory_order_release);
+    }
+    uint32_t FramePeriod() {
+        std::lock_guard guard(lifetime);
+        return data ? data->frame_period.load(std::memory_order_acquire) : 8333333;
+    }
+    bool Publish(unsigned device, const vr::DriverPose_t &pose, uint64_t timestamp) {
+        std::lock_guard guard(lifetime);
+        if (!data || device >= vr::k_unMaxTrackedDeviceCount) return false;
+        pacer.Wait(device, data->frame_period.load(std::memory_order_relaxed));
+        auto &slot = data->slots[device];
+        Snapshot snapshot{timestamp, pose};
+        uint32_t words[word_count];
+        std::memcpy(words, &snapshot, sizeof(snapshot));
+        slot.sequence.fetch_add(1, std::memory_order_acq_rel);
+        for (unsigned i = 0; i < word_count; ++i) slot.words[i].store(words[i], std::memory_order_relaxed);
+        slot.sequence.fetch_add(1, std::memory_order_release);
+        return true;
+    }
+    bool Read(unsigned device, vr::DriverPose_t &pose, uint64_t &timestamp) {
+        std::lock_guard guard(lifetime);
+        if (!data || device >= vr::k_unMaxTrackedDeviceCount) return false;
+        auto &slot = data->slots[device];
+        const auto sequence = slot.sequence.load(std::memory_order_acquire);
+        if ((sequence & 1) || sequence == consumed[device]) return false;
+        uint32_t words[word_count];
+        for (unsigned i = 0; i < word_count; ++i) words[i] = slot.words[i].load(std::memory_order_relaxed);
+        std::atomic_thread_fence(std::memory_order_acquire);
+        if (slot.sequence.load(std::memory_order_relaxed) != sequence) return false;
+        Snapshot snapshot;
+        std::memcpy(&snapshot, words, sizeof(snapshot));
+        pose = snapshot.pose;
+        timestamp = snapshot.timestamp;
+        consumed[device] = sequence;
+        return true;
+    }
+};
+
+inline QuestPoseChannel &QuestPoses() {
+    // Shutdown closes the mapping explicitly; keep this object alive until the
+    // process exits, independent of RpcSystem static-destructor ordering.
+    static auto *channel = new QuestPoseChannel;
+    return *channel;
+}
diff --git a/projects/common/quest_property_cache.h b/projects/common/quest_property_cache.h
new file mode 100644
index 0000000..7a0629f
--- /dev/null
+++ b/projects/common/quest_property_cache.h
@@ -0,0 +1,83 @@
+#pragma once
+#include <openvr_driver.h>
+#include <array>
+#include <chrono>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <utility>
+#include <vector>
+
+// Only the Quest Standable adapter uses this cache. Revalidate successful
+// writes/handles at least once a second; changed values always go through.
+class QuestPropertyCache {
+public:
+    using Clock = std::chrono::steady_clock;
+private:
+    using Key = std::pair<vr::PropertyContainerHandle_t, vr::ETrackedDeviceProperty>;
+    struct Value {
+        vr::PropertyTypeTag_t tag;
+        std::vector<char> bytes;
+        Clock::time_point expires;
+    };
+    std::mutex mutex;
+    std::map<Key, Value> values;
+public:
+    template<class Forward>
+    vr::ETrackedPropertyError Write(vr::PropertyContainerHandle_t container,
+            vr::PropertyWrite_t *batch, uint32_t count, Forward forward,
+            Clock::time_point now = Clock::now()) {
+        std::lock_guard lock(mutex);
+        const bool eligible = container != vr::k_ulInvalidPropertyContainer &&
+            count == 1 && batch && batch[0].writeType == vr::PropertyWrite_Set &&
+            batch[0].unBufferSize > 0 && batch[0].unBufferSize <= 512 && batch[0].pvBuffer;
+        if (eligible) {
+            auto &entry = batch[0];
+            auto found = values.find({container, entry.prop});
+            if (found != values.end() && now < found->second.expires &&
+                    found->second.tag == entry.unTag &&
+                    found->second.bytes.size() == entry.unBufferSize &&
+                    !std::memcmp(found->second.bytes.data(), entry.pvBuffer, entry.unBufferSize)) {
+                entry.eError = vr::TrackedProp_Success;
+                return vr::TrackedProp_Success;
+            }
+        }
+        // Erases, errors, multi-entry batches and failed writes invalidate prior
+        // successful values. They retain the original RPC/error behavior.
+        if (batch) for (uint32_t i = 0; i < count; ++i) values.erase({container, batch[i].prop});
+        auto result = forward();
+        if (eligible && result == vr::TrackedProp_Success && batch[0].eError == vr::TrackedProp_Success) {
+            if (values.size() >= 128) values.clear();
+            const auto &entry = batch[0];
+            const auto *bytes = static_cast<const char *>(entry.pvBuffer);
+            values.emplace(Key{container, entry.prop}, Value{entry.unTag,
+                std::vector<char>(bytes, bytes + entry.unBufferSize), now + std::chrono::seconds(1)});
+        }
+        return result;
+    }
+};
+
+class QuestContainerCache {
+public:
+    using Clock = std::chrono::steady_clock;
+private:
+    struct Value {
+        vr::PropertyContainerHandle_t handle = vr::k_ulInvalidPropertyContainer;
+        Clock::time_point expires{};
+    };
+    std::mutex mutex;
+    std::array<Value, vr::k_unMaxTrackedDeviceCount> values{};
+public:
+    template<class Forward>
+    vr::PropertyContainerHandle_t Get(vr::TrackedDeviceIndex_t device, Forward forward,
+            Clock::time_point now = Clock::now()) {
+        if (device >= values.size()) return forward();
+        std::lock_guard lock(mutex);
+        auto &value = values[device];
+        if (value.handle == vr::k_ulInvalidPropertyContainer || now >= value.expires) {
+            value.handle = forward();
+            value.expires = now + std::chrono::seconds(1);
+        }
+        return value.handle;
+    }
+};
