.git
.cache
.cxx
.gradle
.idea
build
build-*
buildpi
out
squashfs-root
vanilla-master

# The standalone OS shell does not build or link these desktop/receiver
# targets.  Keeping their large sources out of the Docker context makes an
# iterative VM image build take seconds instead of transferring hundreds of
# megabytes (notably the OpenVR SDK checkout).
openvr
steamvr-driver
pi-receiver
utility
tests
scripts
buildroot
build-win64-msvc
docker
.github

# The VM build compiles the small VM-only OpenVR fake controller provider.
# Keep the legacy Windows driver and large assets excluded while allowing the
# source and manifest needed by SVRT_BUILD_FAKE_TRACKING through the context.
!steamvr-driver/
steamvr-driver/*
!steamvr-driver/CMakeLists.txt
!steamvr-driver/fake_tracking.cpp
!steamvr-driver/svrt-fake/
!steamvr-driver/svrt-fake/**
